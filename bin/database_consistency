#!/usr/bin/env ruby
require "rubygems"
require "bundler/setup"

# Optional baseline for deferred findings. Pass -c yourself to override.
todo = File.expand_path("../.database_consistency.todo.yml", __dir__)
unless ARGV.include?("-c") || ARGV.include?("--config") || ARGV.include?("install") || !File.exist?(todo)
  ARGV.unshift("-c", todo)
end

load Gem.bin_path("database_consistency", "database_consistency")
