{
  "name": "app",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.27.2"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets --loader:.png=file --loader:.svg=file",
    "build:css": "npx @tailwindcss/cli -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --minify"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.20",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/typography": "latest",
    "@tailwindplus/elements": "^1.0.0",
    "chart.js": "^4.5.1",
    "tailwindcss": "^4.1.18"
  }
}
