MEASUREMENT_API_KEY=
OPENWEATHER_API_KEY=
SENTRY_DSN=
# Optional overrides (defaults: Rails.env / HEROKU_SLUG_COMMIT on Heroku).
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Station coordinates (Auburn, WA). Used for forecast, quakes,
# wildfire distance, aurora OVATION sampling, planet/ISS geometry.
LOCATION_LAT=
LOCATION_LON=
# Station elevation in feet. Reduces barometer_abs to sea-level / altimeter
# (dashboard, reports, records, third-party uploads). Default 416.
LOCATION_ELEVATION_FT=416
# LibreWXR API origin for /radar composite tiles (precip, cloud, alerts).
# Defaults to the public instance when unset.
LIBREWXR_API_BASE=https://api.librewxr.net
# Free CARTO basemap API key for /radar vector Dark Matter style (`?key=`).
# Request at https://carto.com/basemaps/apikey/ (register domain, e.g. lhwx.org).
# Recommended now; CARTO may require it for vector later (raster already does).
CARTO_API_KEY=
# AirNow monitor for live AQI / PM2.5 (default: Auburn 29th St).
AIRNOW_AQSID=840530330047

# Master switch for third-party weather uploads (must be exactly "true").
SEND_WX=

WU_STATION_ID=
WU_STATION_KEY=
WINDY_API_KEY=
PWS_STATION_ID=
PWS_STATION_KEY=
AWEKAS_USERNAME=
AWEKAS_PASSWORD=
WEATHERCLOUD_DEVICE_ID=
WEATHERCLOUD_DEVICE_KEY=
# CWOP/APRS callsign (e.g. GW1125). Passcode is always -1 for non-ham stations.
CWOP_CALLSIGN=