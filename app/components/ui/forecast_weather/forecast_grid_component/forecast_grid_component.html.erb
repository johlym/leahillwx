<div class="weather-tile weekly-forecast">
  <h2 class="weather-tile-heading">7-day Forecast</h2>
  <p class="forecast-timestamp">as of <%= formatted_timestamp %>. Forecast data via <%= link_to "OpenWeatherMap", "https://openweathermap.org/?utm_source=leahillwx.org&utm_medium=referral", target: "_blank", class: "underline" %>.</p>
  <% forecast.days.each do |entry| %>
  <div class="forecast-entry">
    <div class="date-grid">
      <p class="dayname"><%= entry.date.strftime("%a") %></p>
      <p class="daynum"><%= entry.date.strftime("%b") %> <%= entry.date.strftime("%-d") %></p>
    </div>
    <div class="conditions">
      <div class="icon">
        <%= render "root/shared/weather_icon", icon: entry.weather_icon %>
      </div>
      <div class="high-low">
        <span class="high"><%= entry.temp_max.round %>°</span>
        <span class="low"><%= entry.temp_min.round %>°</span>
      </div>
    </div>
    <div class="forecast-text">
      <p class="forecast-description"><%= entry.weather_description&.titleize %></p>
      <p class="forecast-summary"><%= entry.summary %>.</p>
    </div>
    <div class="wind">
      <p><span class="wind-speed"><%= entry.wind_speed.round %></span> <span class="unit">mph</span> <%= render Elements::WindVaneComponent.new(direction: entry.wind_dir) %></p>
      <p class="wind-gust"><%= entry.wind_gust ? "#{entry.wind_gust.round} mph gusts" : "" %></p>
    </div>
  </div>
  <% end %>
</div>
