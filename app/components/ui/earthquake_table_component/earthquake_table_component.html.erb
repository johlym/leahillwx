<table class="earthquake-table">
  <thead>
    <tr>
      <th scope="col">Mag</th>
      <th scope="col">Time</th>
      <th scope="col">Location</th>
      <th scope="col">Distance</th>
      <th scope="col">Depth</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @earthquakes.each_with_index do |earthquake, index| %>
    <tr>
      <td class="eq-cell eq-mag-cell">
        <%= earthquake.magnitude %>
      </td>
      <td class="eq-cell">
        <%= earthquake.eventtime.in_time_zone("America/Los_Angeles").strftime("%B %d, %Y") %><br />
        at <%= earthquake.eventtime.in_time_zone("America/Los_Angeles").strftime("%I:%M %p") %>
      </td>
      <td class="eq-cell">
        <%= earthquake.place %> 
      </td>
      
      <td class="eq-cell">
        <%= number_with_precision(earthquake.distance, precision: 2) %> mi
      </td>
      <td class="eq-cell">
        <%= number_with_precision(earthquake.depth, precision: 2) %> mi
      </td>
      <td class="eq-cell link-cell">
        <%= link_to earthquake.url, target: :blank, class: "text-sm" do %>
          View at<br />USGS
        <% end %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>