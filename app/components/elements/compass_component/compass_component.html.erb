<div class="compass compass--<%= size %>"
     role="img"
     aria-label="Wind from <%= compass_label %> (<%= direction.round %>°)">
  <svg viewBox="0 0 100 100" class="compass__dial" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <%# Outer ring — inspired by the reference: single subtle circle,
        no gradient, no fill. %>
    <circle cx="50" cy="50" r="44" fill="none" class="compass__ring" stroke-width="1.5" />

    <%# Cardinal letters. %>
    <g class="compass__cardinals" font-size="9" text-anchor="middle" dominant-baseline="middle">
      <text x="50" y="16" class="compass__cardinal--n">N</text>
      <text x="87" y="53">E</text>
      <text x="50" y="92">S</text>
      <text x="13" y="53">W</text>
    </g>

    <%# Four cardinal tick marks — clean and simple like the reference. %>
    <g class="compass__ticks" stroke-width="1.4">
      <line x1="50" y1="8" x2="50" y2="14" />
      <line x1="92" y1="50" x2="86" y2="50" />
      <line x1="50" y1="92" x2="50" y2="86" />
      <line x1="8" y1="50" x2="14" y2="50" />
    </g>

    <%# Needle — diamond-shape blades so each half tapers cleanly to
        the hub. `direction` is meteorological (0 = N, 90 = E). %>
    <g class="compass__needle" transform="rotate(<%= direction %> 50 50)">
      <path d="M50 18 L44 52 L50 47 L56 52 Z" class="compass__needle-fore" />
      <path d="M50 82 L46 52 L50 55 L54 52 Z" class="compass__needle-aft" />
    </g>

    <%# Center hub — a bright cap so the needle terminates crisply. %>
    <circle cx="50" cy="50" r="3.5" class="compass__hub" />
  </svg>

  <% if show_label %>
    <span class="compass__label"><%= compass_label %></span>
  <% end %>
</div>
