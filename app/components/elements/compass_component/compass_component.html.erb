<div class="compass compass--<%= size %>"
     role="img"
     aria-label="Wind from <%= compass_label %> (<%= direction.round %>°)">
  <svg viewBox="0 0 100 100" class="compass__dial" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <radialGradient id="compass-face-<%= object_id %>" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--surface-2)" />
        <stop offset="90%" stop-color="var(--surface)" />
      </radialGradient>
      <linearGradient id="compass-needle-<%= object_id %>" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0%" stop-color="var(--accent-strong)" />
        <stop offset="100%" stop-color="var(--accent)" />
      </linearGradient>
    </defs>

    <circle cx="50" cy="50" r="46" fill="url(#compass-face-<%= object_id %>)"
            stroke="var(--border-strong)" stroke-width="1" />
    <circle cx="50" cy="50" r="41" fill="none"
            stroke="color-mix(in oklab, var(--border) 60%, transparent)" stroke-width="0.5" />

    <%# Tick marks: long tick every 45°, short tick every 22.5°. %>
    <% 16.times do |i| %>
      <% deg = i * 22.5 %>
      <% long = (i % 2).zero? %>
      <line x1="50" y1="<%= long ? 6 : 8 %>" x2="50" y2="<%= long ? 12 : 11 %>"
            stroke="<%= long ? "var(--muted)" : "color-mix(in oklab, var(--muted) 60%, transparent)" %>"
            stroke-width="<%= long ? 1.2 : 0.8 %>"
            transform="rotate(<%= deg %> 50 50)" />
    <% end %>

    <%# Cardinal letters. %>
    <text x="50" y="20" text-anchor="middle" font-size="10" font-weight="700"
          fill="var(--danger)" font-family="var(--font-condensed)">N</text>
    <text x="82" y="53" text-anchor="middle" font-size="8"
          fill="var(--muted)" font-family="var(--font-condensed)">E</text>
    <text x="50" y="86" text-anchor="middle" font-size="8"
          fill="var(--muted)" font-family="var(--font-condensed)">S</text>
    <text x="18" y="53" text-anchor="middle" font-size="8"
          fill="var(--muted)" font-family="var(--font-condensed)">W</text>

    <%# Rotating needle group. `direction` is meteorological (where the
        wind is coming from), rotating 0° = North, 90° = East, etc. %>
    <g class="compass__needle" transform="rotate(<%= direction %> 50 50)">
      <polygon points="50,14 46,52 54,52"
               fill="url(#compass-needle-<%= object_id %>)"
               stroke="var(--accent-strong)"
               stroke-width="0.5" />
      <polygon points="50,86 47,52 53,52"
               fill="color-mix(in oklab, var(--muted) 65%, transparent)"
               stroke="var(--border-strong)"
               stroke-width="0.5" />
    </g>

    <circle cx="50" cy="50" r="3" fill="var(--surface-2)" stroke="var(--accent)" stroke-width="1" />
  </svg>
  <% if show_label %>
    <span class="compass__label"><%= compass_label %></span>
  <% end %>
</div>
