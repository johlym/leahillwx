<div class="compass compass--<%= size %>"
     role="img"
     aria-label="Wind from <%= compass_label %> (<%= direction.round %>°)">
  <svg viewBox="0 0 100 100" class="compass__dial" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <%# Compass face — a slightly darker inset surface. Kept as a
        simple solid so we don't rely on <linearGradient> stop-color
        variables (which some engines evaluate lazily and drop). %>
    <circle cx="50" cy="50" r="46"
            class="compass__face"
            stroke-width="1" />
    <circle cx="50" cy="50" r="41" fill="none"
            class="compass__ring"
            stroke-width="0.5" />

    <%# Tick marks: long tick every 45°, short tick every 22.5°. %>
    <% 16.times do |i| %>
      <% deg = i * 22.5 %>
      <% long = (i % 2).zero? %>
      <line x1="50" y1="<%= long ? 6 : 8 %>" x2="50" y2="<%= long ? 12 : 11 %>"
            class="<%= long ? 'compass__tick compass__tick--long' : 'compass__tick' %>"
            stroke-width="<%= long ? 1.4 : 0.8 %>"
            transform="rotate(<%= deg %> 50 50)" />
    <% end %>

    <%# Cardinal letters. %>
    <text x="50" y="21" text-anchor="middle" font-size="10" font-weight="700"
          class="compass__cardinal compass__cardinal--n">N</text>
    <text x="83" y="53" text-anchor="middle" font-size="8"
          class="compass__cardinal">E</text>
    <text x="50" y="88" text-anchor="middle" font-size="8"
          class="compass__cardinal">S</text>
    <text x="17" y="53" text-anchor="middle" font-size="8"
          class="compass__cardinal">W</text>

    <%# Needle. `direction` is meteorological (where the wind is coming
        from), 0° = N, 90° = E. Rotation is applied as an SVG attribute
        so the initial paint is correct even before the weather channel
        broadcasts an update. Both blades share a class so the CSS
        variable-driven fill and stroke apply reliably. %>
    <g class="compass__needle" transform="rotate(<%= direction %> 50 50)">
      <polygon points="50,10 44,52 56,52"
               class="compass__needle-fore"
               stroke-width="1.2" />
      <polygon points="50,90 46,52 54,52"
               class="compass__needle-aft"
               stroke-width="0.8" />
    </g>

    <circle cx="50" cy="50" r="3.5"
            class="compass__hub"
            stroke-width="1" />
  </svg>
  <% if show_label %>
    <span class="compass__label"><%= compass_label %></span>
  <% end %>
</div>
