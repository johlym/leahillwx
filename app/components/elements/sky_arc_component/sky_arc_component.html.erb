<%#
  Coordinate system: viewBox 0 0 200 110. Horizon line lives at y=100
  so the arc has 100 units of vertical headroom above and 10 below
  for tick labels. The arc itself sweeps from (10, 100) -> (100, 10)
  -> (190, 100), giving a nice half-dome.
%>
<div class="sky-arc" role="img" aria-label="Sun and moon paths for today">
  <svg viewBox="0 0 200 130" class="sky-arc-svg" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    <defs>
      <linearGradient id="sky-fill-<%= uid %>" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0%"  style="stop-color: color-mix(in oklab, var(--color-accent) 55%, transparent)" />
        <stop offset="60%" style="stop-color: color-mix(in oklab, var(--color-accent) 22%, transparent)" />
        <stop offset="100%" style="stop-color: transparent" />
      </linearGradient>
    </defs>

    <%# Filled sky beneath the sun arc for atmosphere. %>
    <path d="M 10 100 A 90 90 0 0 1 190 100 L 190 100 L 10 100 Z"
          fill="url(#sky-fill-<%= uid %>)"
          opacity="0.9" />

    <%# Horizon line. %>
    <line x1="6" y1="100" x2="194" y2="100"
          style="stroke: color-mix(in oklab, var(--color-border-strong) 65%, transparent)"
          stroke-width="1" />

    <%# Sun arc. %>
    <path d="M 10 100 A 90 90 0 0 1 190 100"
          fill="none"
          style="stroke: var(--color-warning)"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-dasharray="4 2" />

    <%# Moon arc, drawn slightly higher (r=78) so it sits inside the sun arc
        and they don't overlap visually. Rendered only when the moon has a
        rise/set pair for today. %>
    <% if moon_progress %>
      <path d="M 22 100 A 78 78 0 0 1 178 100"
            fill="none"
            style="stroke: color-mix(in oklab, var(--color-muted) 80%, transparent)"
            stroke-width="1"
            stroke-linecap="round"
            stroke-dasharray="2 3" />
    <% end %>

    <%# Sun body position. Angle from horizon = progress * 180°. %>
    <% sun_theta = (sun_progress * Math::PI) %>
    <% sun_cx = 100 - Math.cos(sun_theta) * 90 %>
    <% sun_cy = 100 - Math.sin(sun_theta) * 90 %>
    <% sun_stroke_class = sun_up? ? "sky-arc-body sky-arc-body-sun sky-arc-body-live" : "sky-arc-body sky-arc-body-sun sky-arc-body-dim" %>
    <g class="<%= sun_stroke_class %>">
      <circle cx="<%= sun_cx.round(2) %>" cy="<%= sun_cy.round(2) %>" r="7"
              style="fill: var(--color-warning); stroke: color-mix(in oklab, var(--color-warning) 60%, transparent)"
              stroke-width="2" />
    </g>

    <%# Moon body position (only when data exists). %>
    <% if moon_progress %>
      <% moon_theta = moon_progress * Math::PI %>
      <% moon_cx = 100 - Math.cos(moon_theta) * 78 %>
      <% moon_cy = 100 - Math.sin(moon_theta) * 78 %>
      <% moon_class = moon_up? ? "sky-arc-body sky-arc-body-moon sky-arc-body-live" : "sky-arc-body sky-arc-body-moon sky-arc-body-dim" %>
      <g class="<%= moon_class %>">
        <circle cx="<%= moon_cx.round(2) %>" cy="<%= moon_cy.round(2) %>" r="5"
                style="fill: color-mix(in oklab, var(--color-muted) 90%, transparent); stroke: color-mix(in oklab, var(--color-text-strong) 40%, transparent)"
                stroke-width="1.5" />
      </g>
    <% end %>

    <%# Rise / transit / set labels along the horizon and apex. %>
    <text x="10" y="118" text-anchor="start" font-size="8"
          style="fill: var(--color-muted); font-family: var(--font-condensed)">
      <%= sun_rise_label %>
    </text>
    <text x="100" y="118" text-anchor="middle" font-size="8"
          style="fill: var(--color-muted); font-family: var(--font-condensed)">
      <%= sun_transit_label %>
    </text>
    <text x="190" y="118" text-anchor="end" font-size="8"
          style="fill: var(--color-muted); font-family: var(--font-condensed)">
      <%= sun_set_label %>
    </text>
  </svg>

  <div class="sky-arc-legend">
    <div class="sky-arc-legend-row">
      <span class="sky-arc-swatch sky-arc-swatch-sun"></span>
      <span>Sun</span>
      <span class="sky-arc-legend-times"><%= sun_rise_label %> &ndash; <%= sun_set_label %></span>
    </div>
    <% if moon_rise_label || moon_set_label %>
      <div class="sky-arc-legend-row">
        <span class="sky-arc-swatch sky-arc-swatch-moon"></span>
        <span>Moon</span>
        <span class="sky-arc-legend-times">
          <%= moon_rise_label || "\u2014" %> &ndash; <%= moon_set_label || "\u2014" %>
        </span>
      </div>
    <% end %>
  </div>
</div>
