<%#
  Coordinate system: viewBox 0 0 200 130. Horizon at y=100.
  Each body has a fixed semicircle arc (rise left → set right). Glyphs
  sit at time-progress along that arc (0° before rise, 180° after set).
%>
<div class="sky-arc" role="img" aria-label="Sky paths for <%= bodies.map(&:label).to_sentence %>">
  <svg viewBox="0 0 200 130" class="sky-arc-svg" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    <defs>
      <linearGradient id="sky-fill-<%= uid %>" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0%"  style="stop-color: color-mix(in oklab, var(--color-accent) 55%, transparent)" />
        <stop offset="60%" style="stop-color: color-mix(in oklab, var(--color-accent) 22%, transparent)" />
        <stop offset="100%" style="stop-color: transparent" />
      </linearGradient>
    </defs>

    <path d="M 10 100 A 90 90 0 0 1 190 100 L 190 100 L 10 100 Z"
          fill="url(#sky-fill-<%= uid %>)"
          opacity="0.9" />

    <line x1="6" y1="100" x2="194" y2="100"
          style="stroke: color-mix(in oklab, var(--color-border-strong) 65%, transparent)"
          stroke-width="1" />

    <% bodies.each do |body| %>
      <path d="<%= arc_d(body) %>"
            fill="none"
            style="stroke: <%= body.color %>"
            stroke-width="<%= body.key == 'sun' ? 1.4 : 1 %>"
            stroke-linecap="round"
            stroke-dasharray="<%= body.key == 'sun' ? '4 2' : '2 3' %>"
            opacity="0.85" />

      <% pt = current_point(body) %>
      <% body_class = [
           "sky-arc-body",
           "sky-arc-body-#{body.key}",
           (up?(body) ? "sky-arc-body-live" : "sky-arc-body-dim")
         ].join(" ") %>
      <g class="<%= body_class %>">
        <circle cx="<%= pt[:x] %>" cy="<%= pt[:y] %>" r="<%= body.glyph_r %>"
                style="fill: <%= body.color %>; stroke: color-mix(in oklab, <%= body.color %> 60%, transparent)"
                stroke-width="1.5" />
      </g>
    <% end %>

    <% sun = bodies.find { |b| b.key == "sun" } %>
    <% if sun %>
      <text x="10" y="118" text-anchor="start" font-size="8"
            style="fill: var(--color-muted); font-family: var(--font-condensed)">
        <%= format_hm(sun.rise_at) %>
      </text>
      <text x="190" y="118" text-anchor="end" font-size="8"
            style="fill: var(--color-muted); font-family: var(--font-condensed)">
        <%= format_hm(sun.set_at) %>
      </text>
    <% end %>
  </svg>

  <div class="sky-arc-legend">
    <% bodies.each do |body| %>
      <div class="sky-arc-legend-row">
        <span class="sky-arc-swatch" style="background: <%= body.color %>"></span>
        <span><%= body.label %></span>
        <span class="sky-arc-legend-times">
          <%= format_hm(body.rise_at) || "—" %> &ndash; <%= format_hm(body.set_at) || "—" %>
        </span>
      </div>
    <% end %>
  </div>
</div>
