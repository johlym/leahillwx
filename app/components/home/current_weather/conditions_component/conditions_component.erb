<section class="current-conditions">
  <div class="conditions-container">
    <div class="conditions-grid">
      <div class="current-conditions-wrapper">
        <p class="timestamp"><%= Time.now.strftime("%B %d, %Y • %I:%M %p") %></p>
        <div class="current-temperature">
          <span class="temperature"><%= current_temperature %>°</span>
          <div class="text-left">
            <i class="fa-regular fa-sun condition-icon"></i>
            <p class="condition-text">Sunny</p>
          </div>
        </div>
        <p class="feels-like">Feels like <%= current_feels_like %>°<% if today_high && today_low %> • High <%= today_high %>° / Low <%= today_low %>°<% end %></p>
      </div>
      <div class="current-conditions-tiles">
        <div class="condition-tile">
          <div class="tile-icon-wrapper">
            <i class="fa-regular fa-wind"></i>
            <span class="tile-title">Wind</span>
          </div>
          <p class="tile-value"><%= current_wind_speed %> mph</p>
          <p class="tile-secondary"><%= current_wind_direction %></p>
        </div>
        <div class="condition-tile">
          <div class="tile-icon-wrapper">
            <i class="fa-regular fa-hand-holding-droplet"></i>
            <span class="tile-title">Humidity</span>
          </div>
          <p class="tile-value"><%= current_humidity %>%</p>
          <p class="tile-secondary">&nbsp;</p>
        </div>
        <div class="condition-tile">
          <div class="tile-icon-wrapper">
            <i class="fa-kit fa-regular-sun-circle-exclamation"></i>
            <span class="tile-title">UV Index</span>
          </div>
          <p class="tile-value"><%= current_uvi %></p>
          <p class="tile-secondary"><%= current_uv_index_category %></p>
        </div>
        <div class="condition-tile">
          <div class="tile-icon-wrapper">
            <i class="fa-regular fa-sunrise"></i>
            <span class="tile-title">Sunrise/Sunset</span>
          </div>
          <p class="tile-value"><%= current_sunrise %></p>
          <p class="tile-secondary"><%= current_sunset %></p>
        </div>
        <div class="condition-tile">
          <div class="tile-icon-wrapper">
            <i class="fa-regular fa-cloud-rain"></i>
            <span class="tile-title">Rain</span>
          </div>
          <p class="tile-value"><%= current_rain_day %> in.</p>
          <p class="tile-secondary"><%= current_rain_hour %> in./hr</p>
        </div>
        <div class="condition-tile">
          <div class="tile-icon-wrapper">
            <i class="fa-regular fa-droplet-degree"></i>
            <span class="tile-title">Dew Point</span>
          </div>
          <p class="tile-value"><%= current_dew_point %>°</p>
          <p class="tile-secondary">&nbsp;</p>
        </div>
      </div>
    </div>
  </div>
</section>