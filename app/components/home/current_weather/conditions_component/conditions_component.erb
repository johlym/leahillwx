<div class="current-conditions">
  <div class="conditions-container">
    <div class="conditions-card temperature-card">
      <div class="timestamp">
        <p><%= @current.reading_date_time.in_time_zone('America/Los_Angeles').then { |t| t.strftime("%B #{t.day.ordinalize}") } %> at <%= @current.reading_date_time.in_time_zone('America/Los_Angeles').then { |t| t.strftime("%I:%M %p") } %></p>
      </div>
      <div class="temperature">
        <%= current_temperature %>°
      </div>
      <div class="conditions">
        <p>Feels Like: <%= current_feels_like %>°</p>
        <p>Wind: <%= current_wind_speed %> mph</p>
        <p>Humidity: <%= current_humidity %> %</p>
      </div>
    </div>
    <div class="conditions-card hourly-card">
      
      
    </div>
  </div>
</div>