<section class="current-conditions" data-palette-transition>
  <%# Same 4-col / gap-3 tracks as the live strip below so Wind/Sun
      align with AQI/Soil (and Humidity/UV with the temp span). %>
  <div class="current-conditions-inner">
    <div class="current-conditions-hero">
      <div class="current-conditions-primary">
        <p class="current-conditions-timestamp"
           data-weather-update-target="timestamp">
          <%= reading_timestamp %>
        </p>

        <div class="current-conditions-temp-row">
          <span class="current-conditions-temp"
                data-weather-update-target="temperature"><%= current_temperature %>°F</span>

          <div class="current-conditions-desc">
            <div class="current-conditions-icon">
              <%= render "root/shared/weather_icon", icon: weather_icon, night: night_time?, blackout: true %>
            </div>
            <p class="current-conditions-summary"><%= weather_description %></p>
          </div>
        </div>

        <p class="current-conditions-feels">
          <span data-weather-update-target="feelsLike">Feels like <%= current_feels_like %>°F</span>
          <% if today_high && today_low %>
            <span class="current-conditions-sep">·</span>
            High <%= today_high %>° / Low <%= today_low %>°
          <% end %>
        </p>
      </div>

      <%= render Ui::CardComponent.new(padding: :default) do %>
        <div class="live-tile">
          <div class="live-tile-split">
            <div class="live-tile-main">
              <div class="live-tile-label">
                <i class="fa-regular fa-wind"></i>
                <span>Wind</span>
              </div>
              <div class="live-tile-body">
                <div class="live-tile-value">
                  <span class="live-tile-number live-tile-number-xl"
                        data-weather-update-target="windSpeed"><%= current_wind_speed %></span>
                  <span class="live-tile-unit live-tile-unit-lg">mph</span>
                </div>
                <p class="live-tile-meta">
                  from <span data-weather-update-target="windDirection"><%= current_wind_direction %></span><br />
                  <span data-weather-update-target="gustSpeed">Gusting to <%= current_gust_speed %> mph</span>
                </p>
              </div>
            </div>
            <div class="live-tile-aside" data-weather-update-target="windCompass">
              <%= render Elements::CompassComponent.new(direction: @current.wind_dir, size: :lg, show_label: false) %>
            </div>
          </div>
          <% if today_peaks[:wind_gust_mph] %>
            <p class="live-tile-peak">Peak gust today <%= today_peaks[:wind_gust_mph] %> mph</p>
          <% end %>
          <%= render Home::CurrentWeather::LiveSparklineComponent.new(
                series: hourly_ranges[:wind],
                metric: "wind",
                y_unit: " mph",
                decimals: 0,
                aria_label: "10-minute average wind speed so far today"
              ) %>
        </div>
      <% end %>

      <% if @almanac %>
        <%= render Ui::CardComponent.new(padding: :default) do %>
          <div class="live-tile-label">
            <i class="fa-regular fa-sunrise"></i>
            <span>Sun &amp; Moon Today</span>
          </div>
          <%= render Elements::SkyArcComponent.new(almanac: @almanac) %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<div class="primary-container">
  <%# lg: 1 Humidity, 2 UV, 3 AQI, 4 Soil (row-span-2)
         5 Rain, 6 Dew Point, 7 Cloud Base, 4 Soil %>
  <div class="live-strip">
    <%= render Ui::CardComponent.new(padding: :default) do %>
      <div class="live-tile">
        <div class="live-tile-label">
          <i class="fa-regular fa-hand-holding-droplet"></i>
          <span>Humidity</span>
        </div>
        <div class="live-tile-body">
          <div class="live-tile-value">
            <span class="live-tile-number" data-weather-update-target="humidity"><%= current_humidity %></span>
            <span class="live-tile-unit">%</span>
          </div>
        </div>
        <% if today_peaks[:humidity] %>
          <p class="live-tile-peak">Peak today <%= today_peaks[:humidity] %>%</p>
        <% end %>
        <%= render Home::CurrentWeather::LiveSparklineComponent.new(
              series: hourly_ranges[:humidity],
              metric: "humidity",
              y_unit: "%",
              decimals: 0,
              aria_label: "10-minute average humidity so far today"
            ) %>
      </div>
    <% end %>

    <%= render Ui::CardComponent.new(padding: :default) do %>
      <div class="live-tile">
        <div class="live-tile-label">
          <i class="fa-kit fa-regular-sun-circle-exclamation"></i>
          <span>UV Index</span>
        </div>
        <div class="live-tile-body">
          <div class="live-tile-value">
            <span class="live-tile-number" data-weather-update-target="uvi"><%= current_uvi %></span>
          </div>
          <div class="uv-scale" aria-hidden="true" style="--uv: <%= uv_marker_position %>%;">
            <div class="uv-scale-marker"></div>
          </div>
          <p class="live-tile-meta">
            <span data-weather-update-target="solarIrradiance"><%= current_solar_irradiance %></span> W/m²
            · <%= current_uv_index_category %>
          </p>
        </div>
        <% if today_peaks[:uvi] %>
          <p class="live-tile-peak">Peak today <%= today_peaks[:uvi] %></p>
        <% end %>
        <%= render Home::CurrentWeather::LiveSparklineComponent.new(
              series: hourly_ranges[:uvi],
              metric: "uvi",
              y_unit: "",
              decimals: 0,
              aria_label: "10-minute average UV index so far today"
            ) %>
      </div>
    <% end %>

    <%= render Home::CurrentWeather::Pm25Component.new(current: aqi, sparkline: hourly_ranges[:aqi]) %>

    <%= render Home::CurrentWeather::SoilComponent.new(readings: @current&.soil_readings || []) %>

    <%= render Ui::CardComponent.new(padding: :default) do %>
      <div class="live-tile">
        <div class="live-tile-label">
          <i class="fa-regular fa-cloud-rain"></i>
          <span>Rain</span>
        </div>
        <div class="live-tile-body">
          <div class="live-tile-value">
            <span class="live-tile-number" data-weather-update-target="rainDay"><%= current_rain_day %></span>
            <span class="live-tile-unit">in</span>
          </div>
          <p class="live-tile-meta">
            <span data-weather-update-target="rainRate"><%= current_rain_hour %></span> in/hr right now
          </p>
        </div>
        <% if today_peaks[:rain_rate_in] %>
          <p class="live-tile-peak">Peak rate today <%= today_peaks[:rain_rate_in] %> in/hr</p>
        <% end %>
        <%= render Home::CurrentWeather::LiveSparklineComponent.new(
              series: hourly_ranges[:rain_rate],
              metric: "rain_rate",
              y_unit: " in",
              decimals: 2,
              aria_label: "10-minute average rain rate so far today"
            ) %>
      </div>
    <% end %>

    <%= render Ui::CardComponent.new(padding: :default) do %>
      <div class="live-tile">
        <div class="live-tile-label">
          <i class="fa-regular fa-droplet-degree"></i>
          <span>Dew Point</span>
        </div>
        <div class="live-tile-body">
          <div class="live-tile-value">
            <span class="live-tile-number" data-weather-update-target="dewPoint"><%= current_dew_point %></span>
            <span class="live-tile-unit">°F</span>
          </div>
        </div>
        <% if today_peaks[:dew_point_f] %>
          <p class="live-tile-peak">Peak today <%= today_peaks[:dew_point_f] %>°F</p>
        <% end %>
        <%= render Home::CurrentWeather::LiveSparklineComponent.new(
              series: hourly_ranges[:dew_point],
              metric: "dew_point",
              y_unit: "°",
              decimals: 0,
              aria_label: "10-minute average dew point so far today"
            ) %>
      </div>
    <% end %>

    <%= render Ui::CardComponent.new(padding: :default) do %>
      <div class="live-tile">
        <div class="live-tile-label">
          <i class="fa-regular fa-cloud"></i>
          <span>Cloud Base</span>
        </div>
        <div class="live-tile-body">
          <div class="live-tile-value">
            <span class="live-tile-number"><%= number_with_delimiter(current_cloud_base_ft) %></span>
            <span class="live-tile-unit">ft</span>
          </div>
          <p class="live-tile-meta">Estimated from temp/dew spread</p>
        </div>
        <%= render Home::CurrentWeather::LiveSparklineComponent.new(
              series: hourly_ranges[:cloud_base],
              metric: "cloud_base",
              y_unit: " ft",
              decimals: 0,
              aria_label: "10-minute average cloud base so far today"
            ) %>
      </div>
    <% end %>
  </div>
</div>
