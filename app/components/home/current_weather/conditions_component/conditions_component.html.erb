<section class="current-conditions" data-palette-transition>
  <div class="current-conditions-inner">
    <div class="current-conditions-hero">
      <div class="current-hero-card">
        <div class="current-hero-glow" aria-hidden="true"></div>
        <div class="relative z-10">
          <span class="current-hero-label">Current Conditions</span>
          <div class="current-hero-temp-row">
            <span class="current-hero-temp"
                  data-weather-update-target="temperature"><%= current_temperature %>°</span>
            <span class="current-hero-unit">F</span>
          </div>
          <div class="current-hero-desc">
            <div class="current-hero-icon">
              <%= render "root/shared/weather_icon", icon: weather_icon, night: night_time?, blackout: true %>
            </div>
            <p class="current-hero-summary"><%= weather_description %></p>
          </div>
        </div>
        <div class="current-hero-stats">
          <div>
            <span class="current-hero-stat-label">Feels Like</span>
            <span class="current-hero-stat-value" data-weather-update-target="feelsLike"><%= current_feels_like %>°F</span>
          </div>
          <div>
            <span class="current-hero-stat-label">Today High</span>
            <span class="current-hero-stat-high"><%= today_high ? "#{today_high}°F" : "—" %></span>
          </div>
          <div>
            <span class="current-hero-stat-label">Today Low</span>
            <span class="current-hero-stat-low"><%= today_low ? "#{today_low}°F" : "—" %></span>
          </div>
        </div>
      </div>

      <div class="current-wind-card">
        <div>
          <span class="current-hero-label">Wind Direction</span>
          <div class="current-wind-dial-wrap" data-weather-update-target="windCompass">
            <%= render Elements::CompassComponent.new(direction: @current.wind_dir, size: :lg, show_label: false) %>
          </div>
          <div class="mt-4 text-center">
            <span class="font-heading text-3xl font-black text-white block leading-none tabular-nums"
                  data-weather-update-target="windSpeed"><%= current_wind_speed %></span>
            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">MPH</span>
          </div>
        </div>
        <div class="current-wind-footer">
          <span data-weather-update-target="gustSpeed">Gusting to <strong class="text-white"><%= current_gust_speed %> mph</strong></span>
          from <strong class="text-white" data-weather-update-target="windDirection"><%= current_wind_direction %></strong>
        </div>
      </div>

      <% if @almanac %>
        <div class="current-sky-card">
          <div>
            <span class="current-hero-label">Celestial Cycles</span>
            <div class="mt-4">
              <%= render Elements::SkyArcComponent.new(almanac: @almanac) %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="live-strip">
      <%= render Ui::CardComponent.new(padding: :default) do %>
        <div class="live-tile">
          <span class="live-tile-label">Humidity</span>
          <div class="live-tile-body">
            <div class="live-tile-value">
              <span class="live-tile-number" data-weather-update-target="humidity"><%= current_humidity %></span>
              <span class="live-tile-unit">%</span>
            </div>
          </div>
          <% if today_peaks[:humidity] %>
            <p class="live-tile-peak">Peak today <strong class="text-slate-300"><%= today_peaks[:humidity] %>%</strong></p>
          <% end %>
        </div>
      <% end %>

      <%= render Ui::CardComponent.new(padding: :default) do %>
        <div class="live-tile">
          <span class="live-tile-label">UV Index</span>
          <div class="live-tile-body">
            <div class="live-tile-value items-center gap-2">
              <span class="live-tile-number" data-weather-update-target="uvi"><%= current_uvi %></span>
              <span class="status-badge <%= uv_badge_class %>"><%= current_uv_index_category %></span>
            </div>
            <div class="uv-scale" aria-hidden="true">
              <div class="uv-scale-fill <%= uv_fill_class %>" style="width: <%= uv_marker_position %>%;"></div>
            </div>
          </div>
        </div>
      <% end %>

      <%= render Home::CurrentWeather::Pm25Component.new(current: aqi, sparkline: hourly_ranges[:aqi]) %>

      <%= render Home::CurrentWeather::SoilComponent.new(readings: @current&.soil_readings || []) %>
    </div>

    <div class="live-strip-secondary">
      <%= render Ui::CardComponent.new(padding: :default) do %>
        <div class="live-tile">
          <span class="live-tile-label">Rainfall</span>
          <div class="live-tile-body">
            <div class="live-tile-value">
              <span class="live-tile-number" data-weather-update-target="rainDay"><%= current_rain_day %></span>
              <span class="live-tile-unit-lg">in</span>
            </div>
          </div>
          <p class="live-tile-meta">
            <span data-weather-update-target="rainRate"><%= current_rain_hour %></span> in/hr right now
          </p>
        </div>
      <% end %>

      <%= render Ui::CardComponent.new(padding: :default) do %>
        <div class="live-tile">
          <span class="live-tile-label">Barometric Pressure</span>
          <div class="live-tile-body">
            <div class="live-tile-value">
              <span class="live-tile-number" data-weather-update-target="pressure"><%= current_barometric_pressure %></span>
              <span class="live-tile-unit">hPa</span>
            </div>
          </div>
          <% if today_peaks[:pressure_hpa] %>
            <p class="live-tile-peak">Peak today <strong class="text-slate-300"><%= today_peaks[:pressure_hpa] %> hPa</strong></p>
          <% end %>
        </div>
      <% end %>

      <%= render Ui::CardComponent.new(padding: :default) do %>
        <div class="live-tile">
          <span class="live-tile-label">Dew Point</span>
          <div class="live-tile-body">
            <div class="live-tile-value">
              <span class="live-tile-number" data-weather-update-target="dewPoint"><%= current_dew_point %></span>
              <span class="live-tile-unit-lg">°F</span>
            </div>
          </div>
          <% if today_peaks[:dew_point_f] %>
            <p class="live-tile-peak">Peak today: <%= today_peaks[:dew_point_f] %>°F</p>
          <% else %>
            <p class="live-tile-meta">Derived from temperature &amp; humidity</p>
          <% end %>
        </div>
      <% end %>

      <%= render Ui::CardComponent.new(padding: :default) do %>
        <div class="live-tile">
          <span class="live-tile-label">Cloud Base</span>
          <div class="live-tile-body">
            <div class="live-tile-value">
              <span class="live-tile-number"><%= number_with_delimiter(current_cloud_base_ft) %></span>
              <span class="live-tile-unit-lg">ft</span>
            </div>
          </div>
          <p class="live-tile-meta">Estimated from temperature &amp; humidity spread</p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%= render Home::CurrentWeather::SkyHazardsComponent.new(
      wildfire: wildfire,
      aurora: aurora,
      planet_night: planet_night,
      iss_pass: iss_pass
    ) %>
