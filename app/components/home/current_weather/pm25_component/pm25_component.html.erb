<%= render Ui::CardComponent.new(padding: :default) do %>
  <div class="live-tile">
    <div class="live-tile-label">
      <i class="fa-solid fa-smog"></i>
      <span>AQI</span>
    </div>
    <div class="live-tile-body">
      <div class="live-tile-value">
        <span class="live-tile-number <%= "live-tile-stale" if stale? %>"><%= aqi_display %></span>
      </div>
      <div class="aqi-scale" aria-hidden="true" style="--aqi: <%= marker_position %>%;">
        <div class="aqi-scale-marker"></div>
      </div>
      <p class="live-tile-meta">
        <%= category %>
        <% if pm25_display %>
          · <%= pm25_display %> µg/m³
        <% end %>
      </p>
      <p class="live-tile-peak <%= "live-tile-stale" if stale? %>"><%= as_of_label %></p>
      <p class="live-tile-meta live-tile-meta-tight"><%= source_label %></p>
    </div>
    <%= render Home::CurrentWeather::LiveSparklineComponent.new(
          series: @sparkline,
          y_unit: "",
          decimals: 0,
          aria_label: "Hourly average AQI over the last 24 hours"
        ) %>
  </div>
<% end %>
