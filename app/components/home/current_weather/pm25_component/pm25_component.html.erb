<%= render Ui::CardComponent.new(padding: :default) do %>
  <div class="live-tile">
    <div class="live-tile-header">
      <span class="live-tile-label">Air Quality (AQI)</span>
      <p class="live-tile-source"><%= source_label %></p>
    </div>
    <div class="live-tile-body">
      <div class="live-tile-value items-center gap-2">
        <span class="live-tile-number <%= "live-tile-stale" if stale? %>"><%= aqi_display %></span>
        <span class="status-badge <%= category_badge_class %>"><%= category %></span>
      </div>
      <div class="aqi-scale" aria-hidden="true">
        <div class="aqi-scale-fill <%= category_fill_class %>" style="width: <%= marker_position %>%;"></div>
      </div>
    </div>
  </div>
<% end %>
