<div class="weather-tile <%= tile_type %>">
  <% if heading? %>
    <h2 class="weather-tile-heading"><%= heading %></h2>
  <% end %>
  <div class="weather-tile-content">
    <% if temperature? %>
      <span class="current-temperature-f" data-weather-update-target="temperature"><%= formatted_temperature %>° F</span>
      <span class="current-temperature-c" data-weather-update-target="feelsLike">(feels like <%= formatted_feels_like %>° F)</span>
      <span class="measurement-id"><span data-weather-update-target="counter">No. <%= counter %> </span></span>
    <% else %>
      <span class="weather-tile-big" <%= "data-weather-update-target=\"#{primary_target}\"" if primary_target %>><%= primary_value %></span>
      <% if secondary_value? %>
        <span class="weather-tile-small" <%= "data-weather-update-target=\"#{secondary_target}\"" if secondary_target %>><%= secondary_value %></span>
      <% end %>
    <% end %>
  </div>
</div>
