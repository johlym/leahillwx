<%= render Ui::CardComponent.new(padding: :default, classes: "soil-card") do %>
  <div class="live-tile">
    <div class="live-tile-label">
      <i class="fa-solid fa-seedling"></i>
      <span>Soil</span>
    </div>

    <div class="live-tile-body live-tile-body-fill">
      <div class="soil-table">
        <div class="soil-table-header" aria-hidden="true">
          <span>Sensor</span>
          <span>Humidity</span>
          <span>Temp.</span>
          <span>Batt.</span>
        </div>

        <div class="soil-channels" data-weather-update-target="soil">
          <% if readings? %>
            <% readings.each do |reading| %>
              <div class="soil-channel">
                <span class="soil-channel-name"><%= reading["name"] %></span>
                <span class="soil-channel-value">
                  <% if reading["moisture"] %>
                    <span class="soil-channel-number"><%= reading["moisture"] %></span><span class="soil-channel-unit">%</span>
                  <% else %>
                    <span class="soil-channel-na">N/A</span>
                  <% end %>
                </span>
                <span class="soil-channel-value">
                  <% if reading["temperature_f"] %>
                    <span class="soil-channel-number"><%= reading["temperature_f"] %></span><span class="soil-channel-unit">°F</span>
                  <% else %>
                    <span class="soil-channel-na">N/A</span>
                  <% end %>
                </span>
                <span class="soil-channel-value">
                  <% if reading["battery"] %>
                    <span class="soil-channel-number soil-channel-battery-number"><%= format("%.2f", reading["battery"]) %></span><span class="soil-channel-unit">V</span>
                  <% else %>
                    <span class="soil-channel-na">N/A</span>
                  <% end %>
                </span>
              </div>
            <% end %>
          <% else %>
            <p class="live-tile-meta">No sensors reporting</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
