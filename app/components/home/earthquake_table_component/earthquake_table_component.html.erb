<div class="earthquake-table-container">
  <div class="earthquake-table">
    <div class="eq-header">
      <div class="eq-header-cell revised-header"></div>
      <div class="eq-header-cell mag-header">Mag</div>
      <div class="eq-header-cell timestamp-header">Timestamp</div>
      <div class="eq-header-cell location-header">Location</div>
      <div class="eq-header-cell distance-header">Distance</div>
      <div class="eq-header-cell depth-header">Depth</div>
    </div>
    <div class="eq-body">
      <% @earthquakes.each_with_index do |earthquake, index| %>
        <div class="eq-row mag-<%= earthquake.magnitude.to_i %>" usgs-id="<%= earthquake.usgs_id %>">
          <div class="eq-cell revised-cell <%= 'revised' if earthquake.revised %>">
            <% if earthquake.revised %>
              <div class="revised-tag">REVISED</div>
            <% end %>
          </div>
          <div class="eq-cell eq-mag-cell">
            <span class="mag">
              <%= number_with_precision(earthquake.magnitude, precision: 1) %>
            </span>
          </div>
          <div class="eq-cell eq-timestamp-cell">
            <% if earthquake.last_updated %>
              <%= earthquake.last_updated.in_time_zone("America/Los_Angeles").strftime("%B %d, %Y") %><br />
              at <%= earthquake.last_updated.in_time_zone("America/Los_Angeles").strftime("%I:%M %p") %>
            <% else %>
              <%= earthquake.eventtime.in_time_zone("America/Los_Angeles").strftime("%B %d, %Y") %><br />
              at <%= earthquake.eventtime.in_time_zone("America/Los_Angeles").strftime("%I:%M %p") %>
            <% end %>
          </div>
          <div class="eq-cell eq-location-cell">
            <%= link_to earthquake.place, earthquake.url, target: :blank %> <i class="fa-regular fa-arrow-up-right-from-square"></i>
          </div>
          <div class="eq-cell eq-distance-cell">
            <%= number_with_precision(earthquake.distance, precision: 2) %> mi
          </div>
          <div class="eq-cell eq-depth-cell">
            <%= number_with_precision(earthquake.depth, precision: 2) %> mi
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<div class="usgs-logo">
  <p>Earthquake feed provided by:</p>
  <%= link_to "https://earthquake.usgs.gov/earthquakes/", target: :blank do %>
    <%= image_tag "usgs.svg", alt: "USGS Logo", width: "100" %>
  <% end %>
</div>