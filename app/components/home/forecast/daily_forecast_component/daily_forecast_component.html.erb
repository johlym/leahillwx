<div class="weather-tile weekly-forecast">
  <h2 class="weather-tile-heading">7-Day Forecast</h2>
  <% days.each do |entry| %>
  <div class="forecast-entry">
    <div class="date-grid">
      <p class="dayname"><%= entry.date.strftime("%a") %></p>
      <p class="daynum"><%= entry.date.strftime("%b %d") %></p>
    </div>
    <div class="conditions">
      <div class="icon">
        <%= render "root/shared/weather_icon", icon: entry.weather_icon %>
      </div>
      <span class="forecast-condition-label"><%= entry.weather_description&.titleize %></span>
    </div>
    <div class="forecast-text">
      <p class="forecast-summary"><%= entry.summary %>.</p>
    </div>
    <div class="forecast-temps">
      <span class="high"><%= entry.temp_max.round %>°</span>
      <span class="low"><%= entry.temp_min.round %>°</span>
    </div>
  </div>
  <% end %>
</div>
