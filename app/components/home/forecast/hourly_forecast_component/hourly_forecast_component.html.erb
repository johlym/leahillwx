<div class="hourly-forecast">
  <div class="hourly-forecast-header">
    <h2 class="weather-tile-heading">Hourly Forecast</h2>
    <p>Data updated via OpenWeatherMap</p>
  </div>

  <div class="hourly-forecast-row">
    <% hours.each do |hour| %>
      <div class="hourly-forecast-item">
        <p class="hour">
          <%= hour.time.in_time_zone("America/Los_Angeles").strftime("%-I %p") %>
        </p>
        <div class="icon-container">
          <%= render "root/shared/weather_icon", icon: hour.weather_icon, night: night_time?(hour.time) %>
        </div>
        <div class="conditions">
          <p class="temperature">
            <%= hour.temp.round %>°
          </p>
          <p class="precip">
            <%= (hour.pop * 100).round %>% Rain
          </p>
        </div>
      </div>
    <% end %>
  </div>
</div>
