<div class="hourly-forecast">
  <h2 class="weather-tile-heading">Hourly Forecast</h2>
  
  <div class="hourly-forecast-row">
    <% hours.each do |hour| %>
      <div class="hourly-forecast-item">
        <p class="hour">
          <%= hour.time.in_time_zone("America/Los_Angeles").strftime("%-I") %> <span class="ampm"><%= hour.time.in_time_zone("America/Los_Angeles").strftime("%p") %></span>
        </p>
        <div class="icon-container">
          <%= render "root/shared/weather_icon", icon: hour.weather_icon %>
        </div>
        <div class="conditions">
          <p class="temperature">
            <%= hour.temp.round %>°
          </p>
          <p class="wind">
            <i class="fa-regular fa-fw fa-wind"></i> <%= hour.wind_speed.round %> | <%= hour.wind_gust.round %>
          </p>
          <p class="precip">
            <i class="fa-regular fa-fw fa-cloud-rain"></i> <%= (hour.pop * 100).round %>%
          </p>
        </div>
      </div>
    <% end %>
  </div>

  <p>as of <%= formatted_timestamp %>. Forecast data via <%= link_to "OpenWeatherMap", "https://openweathermap.org/?utm_source=lhwx.org&utm_medium=referral", target: "_blank", class: "underline" %>.</p>
</div>
