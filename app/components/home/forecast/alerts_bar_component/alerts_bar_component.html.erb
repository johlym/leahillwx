<section class="forecast-alerts-bar" aria-label="Weather alerts" role="region">
  <div class="forecast-alerts-bar-inner">
    <span class="forecast-alerts-bar-label">Alert</span>
    <div class="forecast-alerts-bar-body">
      <p class="forecast-alerts-bar-event"><%= event_label(primary_alert) %></p>
      <% if ends_label(primary_alert) %>
        <p class="forecast-alerts-bar-meta">Until <%= ends_label(primary_alert) %></p>
      <% end %>
      <% if primary_alert.description.present? %>
        <p class="forecast-alerts-bar-desc"><%= truncate(primary_alert.description, length: 220) %></p>
      <% end %>
      <% if extra_count.positive? %>
        <p class="forecast-alerts-bar-more">+<%= extra_count %> more active <%= "alert".pluralize(extra_count) %></p>
      <% end %>
    </div>
  </div>
</section>
