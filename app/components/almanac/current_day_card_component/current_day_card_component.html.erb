<%= render Ui::SectionHeaderComponent.new(
  title: "Today",
  subtitle: entry.date.strftime("%A, %b %d, %Y"),
  icon: "fa-regular fa-calendar-day",
  level: 2
) %>

<div class="ui-card-grid">
  <%= render Ui::CardComponent.new(title: "Sun", icon: "fa-regular fa-sun") do %>
    <ul class="almanac-current-list" role="list">
      <li><span>Rise</span><span><%= format_time(entry.sunrise_at) %></span></li>
      <li><span>Transit</span><span><%= format_time(entry.solar_noon_at) %></span></li>
      <li><span>Set</span><span><%= format_time(entry.sunset_at) %></span></li>
      <% if dynamic_positions && dynamic_positions[:sun] %>
        <li><span>Altitude</span><span><%= format_degrees(dynamic_positions[:sun][:altitude]) %></span></li>
        <li><span>Azimuth</span><span><%= format_degrees(dynamic_positions[:sun][:azimuth]) %></span></li>
      <% end %>
    </ul>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Moon", icon: "fa-regular fa-moon") do %>
    <ul class="almanac-current-list" role="list">
      <li><span>Rise</span><span><%= format_time(entry.moonrise_at) %></span></li>
      <li><span>Transit</span><span><%= format_time(entry.moon_transit_at) %></span></li>
      <li><span>Set</span><span><%= format_time(entry.moonset_at) %></span></li>
      <li><span>Phase</span><span class="almanac-phase"><%= entry.moon_phase %></span></li>
      <li><span>Illumination</span><span><%= entry.moon_illumination_pct&.round %>%</span></li>
      <% if dynamic_positions && dynamic_positions[:moon] %>
        <li><span>Altitude</span><span><%= format_degrees(dynamic_positions[:moon][:altitude]) %></span></li>
        <li><span>Heading</span><span><%= moon_heading %></span></li>
      <% end %>
    </ul>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Details", icon: "fa-regular fa-book-atlas") do %>
    <ul class="almanac-current-list" role="list">
      <li><span>Daylight</span><span><%= entry.formatted_daylight %></span></li>
      <% if entry.formatted_daylight_delta %>
        <li class="almanac-current-meta"><span></span><span><%= entry.formatted_daylight_delta %></span></li>
      <% end %>
      <% if entry.moon_distance_km %>
        <li><span>Moon distance</span><span><%= number_with_delimiter((entry.moon_distance_km * 0.621371).round(0)) %> mi</span></li>
      <% end %>
      <% if entry.sun_distance_km %>
        <li><span>Sun distance</span><span><%= ((entry.sun_distance_km * 0.621371) / 1_000_000).round(2) %>M mi</span></li>
      <% end %>
    </ul>
  <% end %>
</div>
