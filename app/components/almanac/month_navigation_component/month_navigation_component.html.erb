<div class="flex flex-col md:flex-row items-stretch md:items-center md:justify-between gap-3 my-4 mb-6"
     data-controller="almanac-navigation">
  <div class="flex flex-wrap gap-2 [&_.btn-secondary]:text-[0.85rem]">
    <%= link_to almanac_month_path(prev_month.year, prev_month.strftime("%B").downcase), class: "btn-secondary" do %>
      <i class="fa-regular fa-arrow-left" aria-hidden="true"></i>
      <%= prev_month.strftime("%B") %>
    <% end %>
    <%= link_to almanac_month_path(next_month.year, next_month.strftime("%B").downcase), class: "btn-secondary" do %>
      <%= next_month.strftime("%B") %>
      <i class="fa-regular fa-arrow-right" aria-hidden="true"></i>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <label class="inline-flex items-center gap-2 text-[0.8rem] uppercase tracking-[0.05em] text-muted">
      <span>Month</span>
      <select id="month-select" class="ui-year-picker-select">
        <% Date::MONTHNAMES.compact.each_with_index do |month, idx| %>
          <option value="<%= month.downcase %>" <%= 'selected' if idx + 1 == current_month %>><%= month %></option>
        <% end %>
      </select>
    </label>
    <label class="inline-flex items-center gap-2 text-[0.8rem] uppercase tracking-[0.05em] text-muted">
      <span>Year</span>
      <select id="year-select" class="ui-year-picker-select">
        <% (1976..2076).each do |year| %>
          <option value="<%= year %>" <%= 'selected' if year == current_year %>><%= year %></option>
        <% end %>
      </select>
    </label>
    <button type="button" class="btn-primary" data-action="click->almanac-navigation#navigate">Go</button>
  </div>
</div>
