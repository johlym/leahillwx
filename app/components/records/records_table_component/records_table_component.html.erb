<div class="records-container">
  <h1>Weather Records</h1>
 
  <% 
    # Determine which record to display in first data column
    year_record = show_three_columns? ? @selected_year_record : @current_year_record
    year_label = if show_three_columns?
      @selected_year.to_s
    else
      @selected_year == @current_year ? "#{@selected_year} (Jan 1 - yesterday)" : @selected_year.to_s
    end
    current_year_label = "#{@current_year} (Jan 1 - yesterday)"
  %>
 
  <section class="records-section">
    <h2>Temperature Records</h2>
    <table class="records-table">
      <thead>
        <tr>
          <th>Record</th>
          <th><%= year_label %></th>
          <% if show_three_columns? %>
            <th><%= current_year_label %></th>
          <% end %>
          <th>All Time</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Highest Temperature</td>
          <td>
            <%= format_temp(year_record&.highest_temp) %><br>
            <span class="record-date"><%= format_datetime(year_record&.highest_temp_at) %></span>
          </td>
          <% if show_three_columns? %>
            <td>
              <%= format_temp(@current_year_record&.highest_temp) %><br>
              <span class="record-date"><%= format_datetime(@current_year_record&.highest_temp_at) %></span>
            </td>
          <% end %>
          <td>
            <%= format_temp(@all_time_record&.highest_temp) %><br>
            <span class="record-date"><%= format_datetime(@all_time_record&.highest_temp_at) %></span>
          </td>
        </tr>
        <tr>
          <td>Lowest Temperature</td>
          <td>
            <%= format_temp(year_record&.lowest_temp) %><br>
            <span class="record-date"><%= format_datetime(year_record&.lowest_temp_at) %></span>
          </td>
          <% if show_three_columns? %>
            <td>
              <%= format_temp(@current_year_record&.lowest_temp) %><br>
              <span class="record-date"><%= format_datetime(@current_year_record&.lowest_temp_at) %></span>
            </td>
          <% end %>
          <td>
            <%= format_temp(@all_time_record&.lowest_temp) %><br>
            <span class="record-date"><%= format_datetime(@all_time_record&.lowest_temp_at) %></span>
          </td>
        </tr>
        <tr>
          <td>Highest Apparent Temperature</td>
          <td>
            <%= format_temp(year_record&.highest_apparent_temp) %><br>
            <span class="record-date"><%= format_datetime(year_record&.highest_apparent_temp_at) %></span>
          </td>
          <% if show_three_columns? %>
            <td>
              <%= format_temp(@current_year_record&.highest_apparent_temp) %><br>
              <span class="record-date"><%= format_datetime(@current_year_record&.highest_apparent_temp_at) %></span>
            </td>
          <% end %>
          <td>
            <%= format_temp(@all_time_record&.highest_apparent_temp) %><br>
            <span class="record-date"><%= format_datetime(@all_time_record&.highest_apparent_temp_at) %></span>
          </td>
        </tr>
        <tr>
          <td>Lowest Apparent Temperature</td>
          <td>
            <%= format_temp(year_record&.lowest_apparent_temp) %><br>
            <span class="record-date"><%= format_datetime(year_record&.lowest_apparent_temp_at) %></span>
          </td>
          <% if show_three_columns? %>
            <td>
              <%= format_temp(@current_year_record&.lowest_apparent_temp) %><br>
              <span class="record-date"><%= format_datetime(@current_year_record&.lowest_apparent_temp_at) %></span>
            </td>
          <% end %>
          <td>
            <%= format_temp(@all_time_record&.lowest_apparent_temp) %><br>
            <span class="record-date"><%= format_datetime(@all_time_record&.lowest_apparent_temp_at) %></span>
          </td>
        </tr>
        <tr>
          <td>Highest Heat Index</td>
          <td>
            <%= format_temp(year_record&.highest_heat_index) %><br>
            <span class="record-date"><%= format_datetime(year_record&.highest_heat_index_at) %></span>
          </td>
          <% if show_three_columns? %>
            <td>
              <%= format_temp(@current_year_record&.highest_heat_index) %><br>
              <span class="record-date"><%= format_datetime(@current_year_record&.highest_heat_index_at) %></span>
            </td>
          <% end %>
          <td>
            <%= format_temp(@all_time_record&.highest_heat_index) %><br>
            <span class="record-date"><%= format_datetime(@all_time_record&.highest_heat_index_at) %></span>
          </td>
        </tr>
        <tr>
          <td>Lowest Wind Chill</td>
          <td>
            <%= format_temp(year_record&.lowest_wind_chill) %><br>
            <span class="record-date"><%= format_datetime(year_record&.lowest_wind_chill_at) %></span>
          </td>
          <% if show_three_columns? %>
            <td>
              <%= format_temp(@current_year_record&.lowest_wind_chill) %><br>
              <span class="record-date"><%= format_datetime(@current_year_record&.lowest_wind_chill_at) %></span>
            </td>
          <% end %>
          <td>
            <%= format_temp(@all_time_record&.lowest_wind_chill) %><br>
            <span class="record-date"><%= format_datetime(@all_time_record&.lowest_wind_chill_at) %></span>
          </td>
        </tr>
        <tr>
          <td>Largest Daily Temperature Range</td>
          <td>
            <%= format_temp(year_record&.largest_temp_range) %><br>
            <span class="record-date"><%= format_date(year_record&.largest_temp_range_date) %></span>
          </td>
          <% if show_three_columns? %>
