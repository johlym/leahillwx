            </td>
          <% end %>
          <td>
            <%= format_temp(@all_time_record&.largest_temp_range) %><br>
            <span class="record-date"><%= format_date(@all_time_record&.largest_temp_range_date) %></span>
          </td>
        </tr>
        <tr>
          <td>Smallest Daily Temperature Range</td>
          <td>
            <%= format_temp(year_record&.smallest_temp_range) %><br>
            <span class="record-date"><%= format_date(year_record&.smallest_temp_range_date) %></span>
          </td>
          <% if show_three_columns? %>
            <td>
              <%= format_temp(@current_year_record&.smallest_temp_range) %><br>
              <span class="record-date"><%= format_date(@current_year_record&.smallest_temp_range_date) %></span>
            </td>
          <% end %>
          <td>
            <%= format_temp(@all_time_record&.smallest_temp_range) %><br>
            <span class="record-date"><%= format_date(@all_time_record&.smallest_temp_range_date) %></span>
          </td>
        </tr>
      </tbody>
    </table>
  </section>
 
