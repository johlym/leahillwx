<%= render Ui::SectionHeaderComponent.new(
  title: pivot_title,
  subtitle: pivot_subtitle
) do |s| %>
  <% s.with_actions do %>
    <div class="flex items-center gap-3 flex-wrap">
      <%= render Ui::YearPickerComponent.new(
        base_path: records_path,
        current_year: pivot_year? || pivot_month? ? selected_year : nil,
        years: available_years,
        include_all_time: true,
        all_time_label: "All time",
        label: "Pivot"
      ) %>

      <% if months_available_for_pivot.any? && selected_year %>
        <label class="inline-flex items-center gap-2 text-[0.8rem] uppercase tracking-[0.05em] text-muted">
          <span>Month</span>
          <select class="ui-year-picker-select"
                  onchange="if (this.value) { window.location.href = this.value; }">
            <option value="<%= records_year_path(selected_year) %>">All months</option>
            <% months_available_for_pivot.each do |m| %>
              <option value="<%= records_month_path(selected_year, Date::MONTHNAMES[m].downcase) %>"
                      <%= 'selected' if pivot_month? && m == selected_month %>>
                <%= Date::MONTHNAMES[m] %>
              </option>
            <% end %>
          </select>
        </label>
      <% end %>
    </div>
  <% end %>
<% end %>

<%# Heatmap is always the first block below the header regardless of
    pivot. In month view it highlights the pivoted month's row. %>
<% if heatmap_days.present? %>
  <%= render Records::TemperatureHeatmapComponent.new(
    year: heatmap_year,
    days: heatmap_days,
    highlight_month: pivot_month? ? selected_month : nil
  ) %>
<% end %>

<% if pivot_month? %>
  <%= render Records::MonthComponent.new(
    year: selected_year,
    month: selected_month,
    report: report,
    prior_report: prior_report
  ) %>
<% else %>
  <% if active_record.nil? %>
    <%= render Ui::CardComponent.new(padding: :loose) do %>
      <p class="text-muted">
        No records available yet for <%= pivot_title.downcase %>. Records are
        recalculated nightly at 12:02 AM or on demand via
        <code class="record-inline-code">rake records:refresh</code>.
      </p>
    <% end %>
  <% else %>
    <% sections.each do |section| %>
      <%= render Ui::SectionHeaderComponent.new(title: section[:title], icon: section[:icon], level: 3) %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <% section[:rows].each do |row| %>
          <%= render Records::RecordCardComponent.new(row: row, record: active_record, icon: row[:icon], history: yearly_records) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
