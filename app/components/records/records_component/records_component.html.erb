<%= render Ui::SectionHeaderComponent.new(
  title: pivot_title,
  subtitle: pivot_subtitle
) do |s| %>
  <% s.with_actions do %>
    <div class="records-actions">
      <%= render Ui::YearPickerComponent.new(
        base_path: records_path,
        current_year: pivot_year? ? selected_year : nil,
        years: available_years,
        include_all_time: true,
        all_time_label: "All time",
        label: "Pivot"
      ) %>
    </div>
  <% end %>
<% end %>

<% if heatmap_days.present? %>
  <%= render Records::TemperatureHeatmapComponent.new(
    year: heatmap_year,
    days: heatmap_days
  ) %>
<% end %>

<% if active_record.nil? %>
  <%= render Ui::CardComponent.new(padding: :loose) do %>
    <p class="text-[color:var(--muted)]">
      No records available yet for <%= pivot_title.downcase %>. Records are
      recalculated nightly at 12:02 AM or on demand via
      <code class="record-inline-code">rake records:refresh</code>.
    </p>
  <% end %>
<% else %>
  <% sections.each do |section| %>
    <%= render Ui::SectionHeaderComponent.new(title: section[:title], icon: section[:icon], level: 3) %>
    <div class="ui-card-grid">
      <% section[:rows].each do |row| %>
        <%= render Records::RecordCardComponent.new(row: row, record: active_record, icon: row[:icon]) %>
      <% end %>
    </div>
  <% end %>
<% end %>
