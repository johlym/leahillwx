<div class="report-table-wrapper">
  <table class="report-table">
    <thead>
      <tr>
        <th scope="col">Record</th>
        <th scope="col"><%= year_label %></th>
        <% if show_three_columns? %>
          <th scope="col"><%= current_year_label %></th>
        <% end %>
        <th scope="col">All Time</th>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <tr>
          <td><%= row[:label] %></td>
          <td>
            <%= format_value(row, row[:year_record]) %><br>
            <span class="text-sm text-gray-600"><%= format_timestamp(row, row[:year_record]) %></span>
          </td>
          <% if show_three_columns? %>
            <td>
              <%= format_value(row, row[:current_year_record]) %><br>
              <span class="text-sm text-gray-600"><%= format_timestamp(row, row[:current_year_record]) %></span>
            </td>
          <% end %>
          <td>
            <%= format_value(row, row[:all_time_record]) %><br>
            <span class="text-sm text-gray-600"><%= format_timestamp(row, row[:all_time_record]) %></span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
