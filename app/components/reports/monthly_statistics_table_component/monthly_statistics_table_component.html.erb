<div class="monthly-statistics">
  <h2>Monthly Statistics</h2>
  <div class="stats-table-wrapper">
    <table class="stats-table">
      <thead>
        <tr>
          <th scope="col">Mean Temp</th>
          <th scope="col">High Temp</th>
          <th scope="col">Low Temp</th>
          <th scope="col">Heat DD</th>
          <th scope="col">Cool DD</th>
          <th scope="col">Total Precip</th>
          <th scope="col">Avg Wind</th>
          <th scope="col">High Wind</th>
          <th scope="col">Wind Dir</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= number_with_precision(report.month_mean_temp.to_fahrenheit, precision: 2) %>° F</td>
          <td><%= number_with_precision(report.month_high_temp.to_fahrenheit, precision: 2) %>° F<br><span class="text-xs">(Day <%= report.month_high_temp_day || 'N/A' %>)</span></td>
          <td><%= number_with_precision(report.month_low_temp.to_fahrenheit, precision: 2) %>° F<br><span class="text-xs">(Day <%= report.month_low_temp_day || 'N/A' %>)</span></td>
          <td><%= number_with_precision(report.total_heat_degree_days, precision: 2) %></td>
          <td><%= number_with_precision(report.total_cool_degree_days, precision: 2) %></td>
          <td><%= number_with_precision(report.total_rain, precision: 2) %> in.</td>
          <td><%= number_with_precision(report.avg_wind_speed, precision: 2) %> mph</td>
          <td><%= number_with_precision(report.month_high_wind_speed, precision: 2) %> mph<br><span class="text-xs">(Day <%= report.month_high_wind_day || 'N/A' %>)</span></td>
          <td><%= report.formatted_dominant_wind %></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
