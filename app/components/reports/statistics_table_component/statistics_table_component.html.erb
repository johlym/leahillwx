<div class="<%= daily? ? 'daily-data' : 'hourly-data' %>">
  <h2>Statistics by <%= daily? ? 'Day' : 'Hour' %></h2>
  <p class="subtitle">Temperature (°F), Rain (in), Wind Speed (mph)</p>
  <div class="partial-day-note">
    <%= partial_note.html_safe %>
  </div>
  <div class="report-table-wrapper">
    <table class="report-table">
      <thead>
        <tr>
          <th scope="col"><%= period_label %></th>
          <th scope="col">Average<br />Temperature</th>
          <th scope="col">High<br />Temperature</th>
          <th scope="col">Low<br />Temperature</th>
          <th scope="col">Heat° Days</th>
          <th scope="col">Cool° Days</th>
          <th scope="col">Rain</th>
          <th scope="col">Avg<br />Wind Speed</th>
          <th scope="col">High<br />Wind Speed</th>
          <th scope="col">Dom.<br />Wind Dir.</th>
        </tr>
      </thead>
      <tbody>
        <% period_data.each do |row| %>
          <tr<%= ' class=partial-day' if row.partial_period? %>>
            <td class="flex items-center gap-1 <%= 'no-data' if !row.has_data? %>">
              <% if daily? %>
                <%= link_to report_day_path(row.report.year, Date::MONTHNAMES[row.report.month].downcase, row.period), class: "flex items-center gap-1" do %>
                  <%= row.period %><i class="fa-solid fa-magnifying-glass"></i>
                <% end %>
              <% else %>
                <%= row.period %>
              <% end %>
              <% if row.partial_period? %>
                <i class="fa-regular fa-triangle-exclamation text-yellow-800"></i>
              <% end %>
            </td>
            <% if !row.has_data? %>
              <% if row.is_current %>
                <td colspan="9" class="no-data">current <%= daily? ? 'day' : 'hour' %></td>
              <% else %>
                <td colspan="9" class="no-data">N/A</td>
              <% end %>
            <% else %>
              <td class="<%= 'font-bold' if row.is_max_mean_temp %>"><%= number_with_precision(row.entry.mean_temp.to_fahrenheit, precision: 2) %>° F</td>
              <td class="<%= 'font-bold' if row.is_max_high_temp %>"><%= number_with_precision(row.entry.high_temp.to_fahrenheit, precision: 2) %>° F @ <%= row.entry.high_temp_time || 'N/A' %></td>
              <td class="<%= 'font-bold' if row.is_max_low_temp %>"><%= number_with_precision(row.entry.low_temp.to_fahrenheit, precision: 2) %>° F @ <%= row.entry.low_temp_time || 'N/A' %></td>
              <td class="<%= 'font-bold' if row.is_max_heat_dd %>"><%= number_with_precision(row.entry.heat_degree_days, precision: 2) %>°</td>
              <td class="<%= 'font-bold' if row.is_max_cool_dd %>"><%= number_with_precision(row.entry.cool_degree_days, precision: 2) %>°</td>
              <td class="<%= 'font-bold' if row.is_max_rain %>"><%= number_with_precision(row.entry.rain / 25.4, precision: 2) %> in.</td>
              <td class="<%= 'font-bold' if row.is_max_avg_wind %>"><%= number_with_precision(row.entry.avg_wind_speed * 2.23694, precision: 2) %> mph</td>
              <td class="<%= 'font-bold' if row.is_max_high_wind %>"><%= number_with_precision(row.entry.high_wind_speed * 2.23694, precision: 2) %> mph @ <%= row.entry.high_wind_time || 'N/A' %></td>
              <td><%= row.entry.formatted_wind_dir %> <%= render Elements::WindVaneComponent.new(direction: row.entry.wind_dir) %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
