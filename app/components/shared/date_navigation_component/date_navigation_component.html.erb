<%
  # Shared classes for the three <select> controls and the two <button>
  # controls in this navigator. Inlined here rather than in a global
  # stylesheet because the component owns all these elements.
  select_classes = "bg-bg-elevated border border-border-strong text-text px-[0.55rem] py-[0.35rem] " \
                   "rounded-[0.35rem] font-[inherit] text-[0.85rem] " \
                   "disabled:opacity-40 disabled:cursor-not-allowed"

  button_classes = "cursor-pointer bg-accent text-accent-contrast border border-accent " \
                   "px-[0.9rem] py-[0.35rem] rounded-[0.35rem] font-[inherit] font-semibold text-[0.8rem] " \
                   "uppercase tracking-[0.05em] " \
                   "hover:enabled:bg-accent-strong hover:enabled:border-accent-strong " \
                   "disabled:opacity-40 disabled:cursor-not-allowed " \
                   "transition-[background-color,border-color] duration-150"

  root_classes = "bg-surface border border-border rounded-[0.6rem] px-4 py-3 my-4 text-text"
%>

<% if @year_only %>
  <div class="<%= root_classes %>">
    <div class="flex flex-wrap items-center gap-2">
      <div class="inline-flex items-center">
        <label for="year-select" class="sr-only">Year:</label>
        <select id="year-select"
                name="year"
                class="<%= select_classes %>"
                onchange="window.location.href = '<%= @base_path %>/' + this.value">
          <% @available_years.each do |available_year| %>
            <option value="<%= available_year %>" <%= 'selected' if available_year == @current_year %>>
              <%= available_year %>
            </option>
          <% end %>
        </select>
      </div>
    </div>
  </div>
<% else %>
  <div class="<%= root_classes %>"
       data-controller="date-navigation"
       data-base-path="<%= @base_path %>"
       data-day-required="<%= @day_required %>">
    <form method="get" data-date-navigation-target="form">
      <div class="flex flex-wrap items-center gap-2">
        <div class="inline-flex items-center">
          <label for="year-select" class="sr-only">Year:</label>
          <select id="year-select"
                  name="year"
                  class="<%= select_classes %>"
                  data-date-navigation-target="yearSelect"
                  data-action="change->date-navigation#updateMonths"
                  data-current-year="<%= @current_year %>"
                  data-current-month="<%= @current_month %>">
            <option value="">Select a Year</option>
          </select>
        </div>

        <div class="inline-flex items-center">
          <label for="month-select" class="sr-only">Month:</label>
          <select id="month-select"
                  name="month"
                  class="<%= select_classes %>"
                  data-date-navigation-target="monthSelect"
                  data-action="change->date-navigation#updateDays"
                  disabled>
            <option value="">Select a Month</option>
          </select>
        </div>

        <div class="inline-flex items-center">
          <label for="day-select" class="sr-only"><%= day_label %></label>
          <select id="day-select"
                  name="day"
                  class="<%= select_classes %>"
                  data-date-navigation-target="daySelect"
                  data-action="change->date-navigation#enableGoButton"
                  data-current-day="<%= @current_day %>"
                  disabled>
            <option value=""><%= @day_required ? "Select a Day" : "Day (optional)" %></option>
          </select>
        </div>

        <div class="inline-flex items-center">
          <button type="button"
                  class="<%= button_classes %>"
                  data-action="click->date-navigation#navigateToDate"
                  data-date-navigation-target="goButton"
                  disabled>
            GO
          </button>
        </div>
        <% if @jump_button %>
          <div class="inline-flex items-center">
            <button type="button"
                    class="<%= button_classes %>"
                    data-action="click->date-navigation#jumpToToday"
                    data-date-navigation-target="jumpButton">
              Jump to Today
            </button>
          </div>
        <% end %>
      </div>
    </form>

    <div class="text-muted text-[0.8rem] mt-[0.4rem]" data-date-navigation-target="message"></div>
  </div>
<% end %>
