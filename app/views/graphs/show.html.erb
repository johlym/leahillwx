<div class="primary-container graphs-container">
  <h1>Graphs</h1>
  
  <%= render Shared::DateNavigationComponent.new(
    current_year: @current_year,
    current_month: @current_month,
    current_day: @current_day,
    base_path: "/graphs",
    day_required: false,
    jump_button: false
  ) %>
  
  <% if @temperature_data && @temperature_data.any? %>
    <div class="graph-section">
      <%= render Graphs::LineGraphComponent.new(
        data: @temperature_data,
        year: @current_year,
        month: @current_month,
        day: @current_day
      ) %>
    </div>
  <% else %>
    <p>No temperature data available for the selected period.</p>
  <% end %>
</div>
