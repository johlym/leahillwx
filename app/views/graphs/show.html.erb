<div class="primary-container">
  <%= render Ui::SectionHeaderComponent.new(
    title: "Graphs",
    subtitle: "#{@month_label} #{@current_year}#{" — Day #{@current_day}" if @current_day}"
  ) %>

  <%= render Shared::DateNavigationComponent.new(
    current_year: @current_year,
    current_month: @current_month,
    current_day: @current_day,
    base_path: "/graphs",
    day_required: false,
    jump_button: false
  ) %>

  <div class="ui-stack-spaced">
    <% if @temperature_chart %>
      <%= render Ui::ChartComponent.new(
        type: @temperature_chart[:type],
        data: @temperature_chart[:data],
        options: @temperature_chart[:options],
        title: "Temperature",
        subtitle: @current_day ? "Hourly" : "Daily high, low, and mean",
        height: 420,
        aria_label: "Line chart of temperature high, low, and mean"
      ) %>
    <% else %>
      <%= render Ui::CardComponent.new do %>
        <p class="ui-message">No temperature data for this period.</p>
      <% end %>
    <% end %>

    <% if @pressure_chart %>
      <%= render Ui::ChartComponent.new(
        type: @pressure_chart[:type],
        data: @pressure_chart[:data],
        options: @pressure_chart[:options],
        title: "Barometric Pressure",
        subtitle: @current_day ? "Hourly high, low, and mean" : "Daily high, low, and mean",
        height: 420,
        aria_label: "Line chart of barometric pressure high, low, and mean"
      ) %>
    <% end %>

    <div class="ui-split-grid">
      <% if @rain_chart %>
        <%= render Ui::ChartComponent.new(
          type: @rain_chart[:type],
          data: @rain_chart[:data],
          options: @rain_chart[:options],
          title: "Rain",
          subtitle: "Precipitation totals",
          height: 320,
          aria_label: "Bar chart of rain totals"
        ) %>
      <% end %>

      <% if @wind_chart %>
        <%= render Ui::ChartComponent.new(
          type: @wind_chart[:type],
          data: @wind_chart[:data],
          options: @wind_chart[:options],
          title: "Wind",
          subtitle: "Average and peak wind speeds",
          height: 320,
          aria_label: "Line chart of wind speeds"
        ) %>
      <% end %>
    </div>
  </div>
</div>
