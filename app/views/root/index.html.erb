<%= turbo_stream_from "weather_measurements" %>

<%= render Home::Forecast::AlertsBarComponent.new(alerts: @forecast&.alerts) %>

<%= render Home::CurrentWeather::ConditionsComponent.new(
  current: @current,
  almanac: @almanac,
  today_forecast: @forecast&.days&.first,
  current_forecast: @forecast&.current,
  today_peaks: @today_peaks,
  aqi: @aqi,
  hourly_ranges: @hourly_ranges,
  wildfire: @wildfire,
  aurora: @aurora,
  planet_night: @planet_night,
  iss_pass: @iss_pass
) %>

<div class="primary-container">
  <% if @forecast&.created_at %>
    <%= render Home::Forecast::HourlyForecastComponent.new(hours: @forecast.hours.first(8), timestamp: @forecast.created_at) %>
  <% end %>

  <div class="home-columns">
    <div class="home-column">
      <% if @forecast&.created_at %>
        <%= render Home::Forecast::DailyForecastComponent.new(days: @forecast.days, timestamp: @forecast.created_at) %>
      <% end %>

      <%= render Ui::CardComponent.new(title: "Earthquakes", subtitle: "The last 5 earthquakes nearest to this location.") do %>
        <%= render Home::EarthquakeTableComponent.new(earthquakes: @earthquakes) %>
      <% end %>
    </div>

    <div class="home-column">
      <%= render Ui::CardComponent.new(title: "Auburn Traffic Cameras", padding: :default) do %>
        <div data-controller="image-refresh">
          <p class="tile-subtitle">
            Next refresh in <span data-image-refresh-target="countdown" class="tile-subtitle-mono">60</span> seconds.
          </p>
          <div class="camera-grid" id="traffic_cameras">
            <figure>
              <figcaption>A ST SE / 2nd ST SE</figcaption>
              <%= image_tag "https://gis.auburnwa.gov/TrafficPhotoWall/TrafficPhotos/226.jpg", alt: "A ST SE / 2nd ST SE" %>
            </figure>
            <figure>
              <figcaption>8th ST NE / Harvey</figcaption>
              <%= image_tag "https://gis.auburnwa.gov/TrafficPhotoWall/TrafficPhotos/28.jpg", alt: "8th ST NE / Harvey" %>
            </figure>
            <figure>
              <figcaption>S 277th ST / Auburn Way N</figcaption>
              <%= image_tag "https://gis.auburnwa.gov/TrafficPhotoWall/TrafficPhotos/12.jpg", alt: "S 277th ST / Auburn Way N" %>
            </figure>
            <figure>
              <figcaption>SE 312th ST / 124th AVE SE</figcaption>
              <%= image_tag "https://gis.auburnwa.gov/TrafficPhotoWall/TrafficPhotos/161.jpg", alt: "SE 312th ST / 124th AVE SE" %>
            </figure>
          </div>
        </div>
      <% end %>

      <%= render Ui::CardComponent.new(title: "Auburn Muni (S50)", padding: :default) do %>
        <div data-controller="image-refresh">
          <p class="tile-subtitle">
            Next refresh in <span data-image-refresh-target="countdown" class="tile-subtitle-mono">60</span> seconds.
          </p>
          <div class="camera-grid" id="airport_cameras">
            <figure>
              <figcaption>North</figcaption>
              <%= image_tag "https://images.wsdot.wa.gov/airports/auburn2.jpg", alt: "North" %>
            </figure>
            <figure>
              <figcaption>East</figcaption>
              <%= image_tag "https://images.wsdot.wa.gov/airports/auburn4.jpg", alt: "East" %>
            </figure>
            <figure>
              <figcaption>South</figcaption>
              <%= image_tag "https://images.wsdot.wa.gov/airports/auburn3.jpg", alt: "South" %>
            </figure>
            <figure>
              <figcaption>West</figcaption>
              <%= image_tag "https://images.wsdot.wa.gov/airports/auburn1.jpg", alt: "West" %>
            </figure>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
