<% content_for :body_class, @almanac.season %>
<%= turbo_stream_from "weather_measurements" %>

<%= render Home::CurrentWeather::ConditionsComponent.new(current: @current, hourly: @hourly_forecast, almanac: @almanac) %>
<div class="primary-container">
  <div class="hourly-forecast">
    <%= render Home::Forecast::HourlyForecastComponent.new(forecast: @forecast, almanac: @almanac) %>
  </div>

  <div class="forecast-section">
    <div class="forecast-column">
      <%= render Home::Forecast::DailyForecastComponent.new(forecast: @forecast) %>
      <%= render Home::GenericTileComponent.new(heading: "Earthquakes", subtitle: "The last 5 earthquakes nearest to this location.") do %>
        <div class="overflow-x-auto">
          <%= render Home::EarthquakeTableComponent.new(earthquakes: @earthquakes) %>
        </div>
      <% end %>
    </div>
    <div class="sidebar-column">
      <%= render Home::GenericTileComponent.new(heading: "Auburn Traffic Cameras") do %>
        <div data-controller="image-refresh">
          <p class="tile-subtitle">
            Next refresh in <span data-image-refresh-target="countdown" class="font-mono">60</span> seconds.
          </p>
          <div class="grid grid-cols-2 gap-2 p-2" id="traffic_cameras">
            <div>
              <h3 class="text-sm text-center font-bold">A ST SE and 2nd ST SE</h3>
              <%= image_tag "https://gis.auburnwa.gov/TrafficPhotoWall/TrafficPhotos/226.jpg" %>
            </div>
            <div>
              <h3 class="text-sm text-center font-bold">8th ST NE and Harvey</h3>
              <%= image_tag "https://gis.auburnwa.gov/TrafficPhotoWall/TrafficPhotos/28.jpg" %>
            </div>
            <div>
              <h3 class="text-sm text-center font-bold">S 277th ST and Auburn Way N</h3>
              <%= image_tag "https://gis.auburnwa.gov/TrafficPhotoWall/TrafficPhotos/12.jpg" %>
            </div>
            <div>
              <h3 class="text-sm text-center font-bold">SE 312th ST and 124th AVE SE</h3>
              <%= image_tag "https://gis.auburnwa.gov/TrafficPhotoWall/TrafficPhotos/161.jpg" %>
            </div>
          </div>
        </div>
      <% end %>
      <%= render Home::GenericTileComponent.new(heading: "Auburn Muni (S50)") do %>
        <div data-controller="image-refresh">
          <p class="tile-subtitle">
            Next refresh in <span data-image-refresh-target="countdown" class="font-mono">60</span> seconds.
          </p>
          <div class="grid grid-cols-2 gap-2 p-2" id="airport_cameras">
            <div>
              <h3 class="text-sm text-center font-bold">North</h3>
              <%= image_tag "https://images.wsdot.wa.gov/airports/auburn2.jpg" %>
            </div>
            <div>
              <h3 class="text-sm text-center font-bold">East</h3>
              <%= image_tag "https://images.wsdot.wa.gov/airports/auburn4.jpg" %>
            </div>
            <div>
              <h3 class="text-sm text-center font-bold">South</h3>
              <%= image_tag "https://images.wsdot.wa.gov/airports/auburn3.jpg" %>
            </div>
            <div>
              <h3 class="text-sm text-center font-bold">West</h3>
              <%= image_tag "https://images.wsdot.wa.gov/airports/auburn1.jpg" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
