<%= turbo_stream_from "weather_measurements" %>

<% if tv_display? %>
  <% content_for :title, "Display — Lea Hill Weather" %>
  <%= render "root/tv_display" %>
<% else %>
  <% if @current %>
    <%= render Home::CurrentWeather::ConditionsComponent.new(
      current: @current,
      almanac: @almanac,
      today_forecast: @forecast&.days&.first,
      current_forecast: @forecast&.current,
      today_peaks: @today_peaks,
      aqi: @aqi,
      hourly_ranges: @hourly_ranges,
      wildfire: @wildfire,
      aurora: @aurora,
      planet_night: @planet_night,
      iss_pass: @iss_pass
    ) %>
  <% else %>
    <%= render "root/station_offline" %>
  <% end %>

  <section class="home-section">
    <div class="home-section-inner">
      <% if @forecast&.created_at %>
        <%= render Home::Forecast::HourlyForecastComponent.new(hours: @forecast.hours.first(8), timestamp: @forecast.created_at) %>
      <% end %>
    </div>
  </section>

  <section class="home-section">
    <div class="home-section-inner">
      <div class="home-columns">
        <div class="home-column home-column-forecast">
          <% if @forecast&.created_at %>
            <%= render Home::Forecast::DailyForecastComponent.new(days: @forecast.days, timestamp: @forecast.created_at) %>
          <% end %>
        </div>

        <div class="home-column home-column-cameras">
          <%= render "root/cameras" %>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="home-section-inner">
      <div class="border-t border-slate-900 pt-8">
        <%= render Ui::CardComponent.new(
              title: "Earthquakes",
              subtitle: "The last 5 earthquakes nearest to this location",
              padding: :loose
            ) do |c| %>
          <% c.with_actions do %>
            <span class="text-[10px] text-slate-500">Earthquake feed provided by USGS</span>
          <% end %>
          <%= render Home::EarthquakeTableComponent.new(earthquakes: @earthquakes) %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
