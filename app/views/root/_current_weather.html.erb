<div id="current_weather" class="text-center">
  <% if current %>
  <h2 class="current-weather"><%= current.temperature.to_fh %> °F <small>(<%= current.temperature %> °C)</small></h2>
  <p class="current-weather-secondary">Feels like <%= current.feels_like.to_fh %> °F (<%= current.feels_like %> °C)</p>
  <p class="current-weather-secondary">More weather measurements coming soon. Measurements taken every 5 seconds and refreshed automatically.</p>
  <p class="current-weather-date">Reading as of <%= current.friendly_reading_date_time %></p>
  <% else %>
  <h2 class="current-weather">No measurements available.</h2>
  <% end %>
</div>
