<div id="current_weather" class="text-center">
  <% if current %>
  <h2 class="current-weather"><%= number_with_precision(current.temperature.to_fh, precision: 2, strip_insignificant_zeros: true) %> °F <small>(<%= number_with_precision(current.temperature, precision: 2, strip_insignificant_zeros: true) %> °C)</small></h2>
  <p class="current-weather-secondary">Feels like <%= number_with_precision(current.feels_like.to_fh, precision: 2, strip_insignificant_zeros: true) %> °F (<%= number_with_precision(current.feels_like, precision: 2, strip_insignificant_zeros: true) %> °C) | Wind speed: <%= number_with_precision(current.wind_speed_mph, precision: 2, strip_insignificant_zeros: true) %> MPH, gusting to <%= number_with_precision(current.gust_speed_mph, precision: 2, strip_insignificant_zeros: true) %> MPH | Wind direction: <%= current.heading_compass %></p>
  <p class="current-weather-secondary">Rainfall today: <%= number_with_precision(current.rain_day_in, precision: 2, strip_insignificant_zeros: true) %> in. (<%= number_with_precision(current.rain_day, precision: 2, strip_insignificant_zeros: true) %> mm) | Rainfall rate: <%= number_with_precision(current.rain_rate_in, precision: 2, strip_insignificant_zeros: true) %> in./hr. (<%= number_with_precision(current.rain_rate, precision: 2, strip_insignificant_zeros: true) %> mm/hr)</p>
  <p class="current-weather-secondary">More weather measurements coming soon. Measurements taken every 5 seconds and refreshed automatically.</p>
  <p class="current-weather-date">Reading as of <%= current.friendly_reading_date_time %>. Measurement #<%= current.id %></p>
  <% else %>
  <h2 class="current-weather">No measurements available.</h2>
  <% end %>
</div>
