<div id="current_weather" class="contents">
  <div class="weather-cell current-temperature">
    <h2 class="weather-cell-heading">Current Temperature</h2>
    <div class="weather-cell-content">
      <span class="current-temperature-f"><%= number_with_precision(current.temperature.to_fahrenheit, precision: 2, strip_insignificant_zeros: true) %>° F</span>
      <span class="current-temperature-c">(feels like <%= number_with_precision(current.feels_like.to_fahrenheit, precision: 2, strip_insignificant_zeros: true) %>° F)</span>
      <span class="measurement-id" data-controller="connection-status">No. <%= number_with_delimiter(current.id) %> <span class="live hidden" data-connection-status-target="badge">LIVE</span></span>
    </div>
  </div>
  <div class="weather-cell current-wind">
    <h2 class="weather-cell-heading">Current Wind</h2>
    <div class="weather-cell-content">
      <span class="weather-cell-big"><%= number_with_precision(current.wind_speed_mph, precision: 2, strip_insignificant_zeros: true) %> mph <%= current.heading_compass %></span>
      <span class="weather-cell-small">Gusting to <%= number_with_precision(current.gust_speed_mph, precision: 2, strip_insignificant_zeros: true) %> mph</span>
    </div>
  </div>
  <div class="weather-cell current-humidity">
    <h2 class="weather-cell-heading">Current Humidity</h2>
    <div class="weather-cell-content">
      <span class="weather-cell-big"><%= current.humidity %> %</span>
    </div>
  </div>
  <div class="weather-cell current-rain">
    <h2 class="weather-cell-heading">Current Rain</h2>
    <div class="weather-cell-content">
      <span class="weather-cell-big"><%= number_with_precision(current.rain_day_in, precision: 2, strip_insignificant_zeros: true) %> in</span>
      <span class="weather-cell-small">(<%= number_with_precision(current.rain_rate_in, precision: 2, strip_insignificant_zeros: true) %> in/hr)</span>
    </div>
  </div>
  <div class="weather-cell current-pressure">
    <h2 class="weather-cell-heading">Current Pressure</h2>
    <div class="weather-cell-content">
      <span class="weather-cell-big"><%= number_with_precision(current.barometer_abs, precision: 2, strip_insignificant_zeros: true) %> mb</span>
    </div>
  </div>
</div>
