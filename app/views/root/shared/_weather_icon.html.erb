<!-- Weather Icon -->
<%# Accepts: icon (OWM icon code like "01d", "02n", etc.) %>
<% base_icon = icon.to_s.gsub(/[dn]$/, '') %>
<% case base_icon %>
<% when '01' %>
  <i class="fa-2x fa-fw fa-duotone fa-solid fa-sun" style="--fa-primary-color: var(--color-brand-800); --fa-secondary-color: var(--color-brand-800);"></i>
<% when '02' %>
  <i class="fa-2x fa-fw fa-duotone fa-solid fa-cloud-sun" style="--fa-primary-color: var(--color-slate-600); --fa-secondary-color: var(--color-brand-800); --fa-secondary-opacity: 1;"></i>
<% when '03' %>
  <i class="fa-2x fa-fw fa-duotone fa-solid fa-cloud" style="--fa-primary-color: var(--color-brand-800); --fa-secondary-color: var(--color-brand-800); --fa-secondary-opacity: 1;"></i>
<% when '04' %>
  <i class="fa-2x fa-fw fa-duotone fa-solid fa-clouds" style="--fa-primary-color: var(--color-brand-800); --fa-secondary-color: var(--color-slate-600); --fa-secondary-opacity: 1;"></i>
<% when '09' %>
  <i class="fa-2x fa-fw fa-duotone fa-solid fa-cloud-rain" style="--fa-primary-color: var(--color-slate-600); --fa-secondary-color: var(--color-brand-800); --fa-secondary-opacity: 1;"></i>
<% when '10' %>
  <i class="fa-2x fa-fw fa-duotone fa-solid fa-cloud-sun-rain" style="--fa-primary-color: #aaaaaa; --fa-secondary-color: var(--color-brand-800); --fa-secondary-opacity: 1;"></i>
<% when '11' %>
  <i class="fa-2x fa-fw fa-duotone fa-solid fa-cloud-bolt" style="--fa-primary-color: var(--color-slate-600); --fa-secondary-color: var(--color-brand-800); --fa-secondary-opacity: 1;"></i>
<% when '13' %>
  <i class="fa-2x fa-fw fa-duotone fa-solid fa-snowflake" style="--fa-primary-color: var(--color-brand-800); --fa-secondary-color: var(--color-brand-800); --fa-secondary-opacity: 1;"></i>
<% when '50' %>
  <i class="fa-2x fa-fw fa-duotone fa-solid fa-cloud-fog" style="--fa-primary-color: var(--color-slate-600); --fa-secondary-color: var(--color-brand-800); --fa-secondary-opacity: 1;"></i>
<% else %>
  <i class="fa-2x fa-fw fa-duotone fa-solid fa-question" style="--fa-primary-color: var(--color-slate-600); --fa-secondary-color: var(--color-slate-600);"></i>
<% end %>