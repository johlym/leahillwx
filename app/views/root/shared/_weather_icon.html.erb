<!-- Weather Icon -->
<%# Accepts: icon (OWM icon code like "01d", "02n", etc.), size (optional, e.g., "3x") %>
<% base_icon = icon.to_s.gsub(/[dn]$/, '') %>
<% prefix = "fa-fw fa-duotone fa-solid" %>
<% isize = local_assigns[:size] ? "fa-#{local_assigns[:size]}" : "fa-2x" %>
<% if local_assigns[:night] %>
  <% sun_moon = "moon" %>
<% else %>
  <% sun_moon = "sun" %>
<% end %>
<% if local_assigns[:blackout] %>
  <% prefix = "fa-fw fa-solid" %>
<% end %>
<% case base_icon %>
<% when '01' %>
  <i class="<%= isize %> <%= prefix %> fa-<%= sun_moon %>" style="--fa-primary-color: var(--color-brand-800); --fa-secondary-color: var(--color-brand-800);"></i>
<% when '02' %>
  <i class="<%= isize %> <%= prefix %> fa-cloud-<%= sun_moon %>" style="--fa-primary-color: var(--color-stone-600); --fa-secondary-color: var(--color-brand-800); --fa-secondary-opacity: 1;"></i>
<% when '03' %>
  <i class="<%= isize %> <%= prefix %> fa-cloud" style="--fa-primary-color: var(--color-brand-800); --fa-secondary-color: var(--color-brand-800); --fa-secondary-opacity: 1;"></i>
<% when '04' %>
  <i class="<%= isize %> <%= prefix %> fa-clouds" style="--fa-primary-color: var(--color-brand-800); --fa-secondary-color: var(--color-stone-600); --fa-secondary-opacity: 1;"></i>
<% when '09' %>
  <i class="<%= isize %> <%= prefix %> fa-cloud-rain" style="--fa-primary-color: var(--color-stone-600); --fa-secondary-color: var(--color-brand-800); --fa-secondary-opacity: 1;"></i>
<% when '10' %>
  <i class="<%= isize %> <%= prefix %> fa-cloud-<%= sun_moon %>-rain" style="--fa-primary-color: #aaaaaa; --fa-secondary-color: var(--color-brand-800); --fa-secondary-opacity: 1;"></i>
<% when '11' %>
  <i class="<%= isize %> <%= prefix %> fa-cloud-bolt-<%= sun_moon %>" style="--fa-primary-color: var(--color-stone-600); --fa-secondary-color: var(--color-brand-800); --fa-secondary-opacity: 1;"></i>
<% when '13' %>
  <i class="<%= isize %> <%= prefix %> fa-snowflake" style="--fa-primary-color: var(--color-brand-800); --fa-secondary-color: var(--color-brand-800); --fa-secondary-opacity: 1;"></i>
<% when '50' %>
  <i class="<%= isize %> <%= prefix %> fa-cloud-fog" style="--fa-primary-color: var(--color-stone-600); --fa-secondary-color: var(--color-brand-800); --fa-secondary-opacity: 1;"></i>
<% else %>
  <i class="<%= isize %> <%= prefix %> fa-question" style="--fa-primary-color: var(--color-stone-600); --fa-secondary-color: var(--color-stone-600);"></i>
<% end %>