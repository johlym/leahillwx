<% if @message %>
  <div class="primary-container">
    <div class="error-message">
      <p><%= @message %></p>
    </div>
  </div>
<% else %>
  <div class="primary-container report-container">
    <%= render Shared::DateNavigationComponent.new(
      current_year: @date.year,
      current_month: @date.month,
      current_day: @date.day,
      base_path: "/almanac",
      day_required: true
    ) %>
    
    <h1>Astronomical Almanac <small>for <%= @date.strftime("%A, %B %d, %Y") %></small></h1>
    
    <%= link_to "Download Text Version", almanac_day_path(@date.year, @date.strftime("%B").downcase, @date.day, format: :txt), class: "download-button" %>
    
    <div class="almanac-data">
      <div class="almanac-section">
        <h2><i class="far fa-sun"></i> Sun</h2>
        <dl class="almanac-list">
          <dt>Start civil twilight</dt>
          <dd><%= format_time(@almanac_entry.civil_dawn_at) %></dd>
          
          <dt>Rise</dt>
          <dd><%= format_time(@almanac_entry.sunrise_at) %></dd>
          
          <dt>Transit</dt>
          <dd><%= format_time(@almanac_entry.solar_noon_at) %></dd>
          
          <dt>Set</dt>
          <dd><%= format_time(@almanac_entry.sunset_at) %></dd>
          
          <dt>End civil twilight</dt>
          <dd><%= format_time(@almanac_entry.civil_dusk_at) %></dd>
          
          <% if @dynamic_positions && @dynamic_positions[:sun] %>
            <dt>Azimuth</dt>
            <dd><%= format_degrees(@dynamic_positions[:sun][:azimuth]) %></dd>
            
            <dt>Altitude</dt>
            <dd><%= format_degrees(@dynamic_positions[:sun][:altitude]) %></dd>
            
            <dt>Right ascension</dt>
            <dd><%= format_degrees(@dynamic_positions[:sun][:right_ascension]) %></dd>
            
            <dt>Declination</dt>
            <dd><%= format_degrees(@dynamic_positions[:sun][:declination]) %></dd>
          <% end %>
          
          <% if @almanac_entry.next_equinox_at %>
            <dt>Equinox</dt>
            <dd><%= format_datetime(@almanac_entry.next_equinox_at) %></dd>
          <% end %>
          
          <% if @almanac_entry.next_solstice_at %>
            <dt>Solstice</dt>
            <dd><%= format_datetime(@almanac_entry.next_solstice_at) %></dd>
          <% end %>
          
          <dt>Total daylight</dt>
          <dd><%= @almanac_entry.formatted_daylight %></dd>
          
          <% if @almanac_entry.formatted_daylight_delta %>
            <dt class="indented"></dt>
            <dd><%= @almanac_entry.formatted_daylight_delta %></dd>
          <% end %>
        </dl>
      </div>
      
      <div class="almanac-section">
        <h2><i class="far fa-moon"></i> Moon</h2>
        <dl class="almanac-list">
          <dt>Rise</dt>
          <dd><%= format_time(@almanac_entry.moonrise_at) %></dd>
          
          <dt>Transit</dt>
          <dd><%= format_time(@almanac_entry.moon_transit_at) %></dd>
          
          <dt>Set</dt>
          <dd><%= format_time(@almanac_entry.moonset_at) %></dd>
          
          <% if @dynamic_positions && @dynamic_positions[:moon] %>
            <dt>Azimuth</dt>
            <dd><%= format_degrees(@dynamic_positions[:moon][:azimuth]) %></dd>
            
            <dt>Altitude</dt>
            <dd><%= format_degrees(@dynamic_positions[:moon][:altitude]) %></dd>
            
            <dt>Right ascension</dt>
            <dd><%= format_degrees(@dynamic_positions[:moon][:right_ascension]) %></dd>
            
            <dt>Declination</dt>
            <dd><%= format_degrees(@dynamic_positions[:moon][:declination]) %></dd>
          <% end %>
          
          <% if @almanac_entry.next_new_moon_at %>
            <dt>New moon</dt>
            <dd><%= format_datetime(@almanac_entry.next_new_moon_at) %></dd>
          <% end %>
          
          <% if @almanac_entry.next_full_moon_at %>
            <dt>Full moon</dt>
            <dd><%= format_datetime(@almanac_entry.next_full_moon_at) %></dd>
          <% end %>
          
          <dt>Phase</dt>
          <dd class="capitalize"><%= @almanac_entry.moon_phase %></dd>
          
          <dt class="indented"></dt>
          <dd><%= @almanac_entry.moon_illumination_pct&.round %>% full</dd>
        </dl>
      </div>
    </div>
    
    <div class="notes">
      <h3>Notes:</h3>
      <ul>
        <li>All times shown in <%= @almanac_entry.timezone %> timezone</li>
        <% if @dynamic_positions %>
          <li>Current positions calculated at page load (<%= Time.current.strftime("%I:%M %p") %>)</li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
