<div class="primary-container">
  <%= render Ui::SectionHeaderComponent.new(
    title: "Astronomical Almanac",
    subtitle: @month_date.strftime("%B %Y"),
    icon: "fa-regular fa-moon-stars",
    level: 1
  ) %>

  <% if @current_entry %>
    <%= render Almanac::CurrentDayCardComponent.new(
      entry: @current_entry,
      dynamic_positions: @dynamic_positions,
      location: @location
    ) %>
  <% end %>

  <%= render Almanac::MonthNavigationComponent.new(
    current_year: @month_date.year,
    current_month: @month_date.month,
    location: @location
  ) %>

  <%= render Almanac::MonthlyCalendarComponent.new(
    month_date: @month_date,
    entries: @entries,
    today: @today
  ) %>
</div>
