<div class="primary-container">
  <h1>Climatological Summary <small>for <%= @report.month_name %> <%= @report.year %></small></h1>

  <%= render Shared::DateNavigationComponent.new(
    current_year: @report.year,
    current_month: @report.month,
    base_path: "/reports",
    day_required: false
  ) %>

  <%= render Reports::DownloadLinkComponent.new(path: report_path(@report.year, Date::MONTHNAMES[@report.month].downcase)) %>

  <%= render Reports::OverviewStatisticsTableComponent.new(report: @report) %>

  <%= render Reports::StatisticsTableComponent.new(report: @report, period_type: :daily, has_partial_periods: has_partial_days?(@report)) %>

  <div class="report-notes">
    <h3>Notes:</h3>
    <ul>
      <li>Times shown in 24-hour format (HH:MM) in the <code>America/Los_Angeles</code> timezone</li>
      <li>Days with no data shown as "N/A"</li>
    </ul>
  </div>
  <p class="report-generation-time">Report generated in <%= @generation_time %> seconds</p>
</div>
