<div class="primary-container">
  <%= render Ui::SectionHeaderComponent.new(title: "Weather Reports", subtitle: "Monthly climatological summaries.") %>

  <%= render Ui::CardComponent.new(padding: :loose) do %>
    <p class="text-text"><%= @message %></p>
    <p class="text-muted mt-2 text-sm">
      Reports are generated daily at 12:01 AM (America/Los_Angeles) from collected weather measurements.
    </p>
  <% end %>
</div>
