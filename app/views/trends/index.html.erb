<div class="primary-container trends-page">
  <%= render Ui::SectionHeaderComponent.new(
    title: "Trends",
    subtitle: "How #{@focus_year} compares to recent history"
  ) do |s| %>
    <% s.with_actions do %>
      <%= render Ui::YearPickerComponent.new(
        base_path: trends_path,
        current_year: @focus_year,
        years: @available_years,
        label: "Focus"
      ) %>
    <% end %>
  <% end %>

  <% unless @has_data %>
    <%= render Ui::CardComponent.new(padding: :loose) do %>
      <p class="text-[color:var(--muted)]">No monthly reports yet. Trends will populate as the reports pipeline runs.</p>
    <% end %>
  <% end %>

  <% if @has_data %>
    <%= render Ui::SectionHeaderComponent.new(title: "Year over year", level: 3, subtitle: "Monthly averages across the last few years. Bold line is the focus year.") %>
    <div class="trends-yoy-grid">
      <%= render Ui::ChartComponent.new(
        type: @yoy_temp_chart[:type],
        data: @yoy_temp_chart[:data],
        options: @yoy_temp_chart[:options],
        title: "Temperature",
        subtitle: "Monthly mean",
        height: 320,
        aria_label: "Year-over-year monthly mean temperature"
      ) %>

      <%= render Ui::ChartComponent.new(
        type: @yoy_rain_chart[:type],
        data: @yoy_rain_chart[:data],
        options: @yoy_rain_chart[:options],
        title: "Rain",
        subtitle: "Monthly total",
        height: 320,
        aria_label: "Year-over-year monthly rainfall"
      ) %>

      <%= render Ui::ChartComponent.new(
        type: @yoy_wind_chart[:type],
        data: @yoy_wind_chart[:data],
        options: @yoy_wind_chart[:options],
        title: "Wind",
        subtitle: "Monthly peak",
        height: 320,
        aria_label: "Year-over-year monthly peak wind"
      ) %>
    </div>

    <%= render Ui::SectionHeaderComponent.new(title: "Rolling averages", level: 3, subtitle: "Longer-term smoothing across every complete day on record.") %>
    <div class="trends-rolling-grid">
      <%= render Ui::ChartComponent.new(
        type: @rolling_temp_chart[:type],
        data: @rolling_temp_chart[:data],
        options: @rolling_temp_chart[:options],
        title: "Temperature — rolling means",
        subtitle: "30, 90, and 365-day windows",
        height: 340,
        aria_label: "Rolling mean temperature at 30, 90, and 365 day windows"
      ) %>

      <% if @rain_cumulative_chart %>
        <%= render Ui::ChartComponent.new(
          type: @rain_cumulative_chart[:type],
          data: @rain_cumulative_chart[:data],
          options: @rain_cumulative_chart[:options],
          title: "Rainfall — cumulative for #{@focus_year}",
          subtitle: "Year-to-date accumulation",
          height: 340,
          aria_label: "Cumulative rainfall for the focus year"
        ) %>
      <% end %>
    </div>

    <% if @anomalies.any? %>
      <%= render Ui::SectionHeaderComponent.new(title: "How #{@focus_year} compares", level: 3, subtitle: "Delta between #{@focus_year} year-to-date and the recent normal.") %>
      <div class="ui-card-grid">
        <% @anomalies.each do |a| %>
          <%= render Ui::CardComponent.new(padding: :default, title: a[:title]) do %>
            <%= render Ui::StatComponent.new(
              value: a[:value],
              label: a[:label],
              secondary: a[:secondary],
              trend: a[:trend],
              trend_label: a[:trend_label]
            ) %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
