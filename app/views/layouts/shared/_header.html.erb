<header class="site-header" data-controller="mobile-menu">
  <nav aria-label="Global" class="site-header-nav">
    <div class="site-header-brand-wrap" data-controller="connection-status">
      <a href="/" class="site-header-brand">
        <%= image_tag "logo.png", alt: "Lea Hill Weather", class: "site-header-logo" %>
        <span class="site-header-title">Lea Hill Weather</span>
      </a>
      <span class="site-header-live-badge hidden"
            data-connection-status-target="badge">LIVE</span>
    </div>

    <div class="site-header-menu-toggle-wrap">
      <button type="button"
              class="site-header-menu-toggle"
              data-mobile-menu-target="button" data-action="click->mobile-menu#toggle" aria-expanded="false">
        <span class="sr-only">Open main menu</span>
        <i class="fa-regular fa-bars" aria-hidden="true" data-mobile-menu-target="openIcon"></i>
        <i class="fa-regular fa-x hidden" aria-hidden="true" data-mobile-menu-target="closeIcon"></i>
      </button>
    </div>

    <div class="site-header-links">
      <%= link_to "Live",    root_path,    class: nav_link_classes(root_path) %>
      <%= link_to "Reports", reports_path, class: nav_link_classes(reports_path) %>
      <%= link_to "Records", records_path, class: nav_link_classes(records_path) %>
      <%= link_to "Graphs",  graphs_path,  class: nav_link_classes(graphs_path) %>
      <%= link_to "Trends",  trends_path,  class: nav_link_classes(trends_path) %>
      <%= link_to "Almanac", almanac_path, class: nav_link_classes(almanac_path) %>
      <%= link_to "About",   about_path,   class: nav_link_classes(about_path) %>
    </div>
  </nav>

  <div id="mobile-menu"
       class="site-header-mobile-menu hidden"
       data-mobile-menu-target="menu">
    <div class="site-header-mobile-links">
      <% [
           ["Live",    root_path],
           ["Reports", reports_path],
           ["Records", records_path],
           ["Graphs",  graphs_path],
           ["Trends",  trends_path],
           ["Almanac", almanac_path],
           ["About",   about_path]
         ].each do |label, path| %>
        <%= link_to label, path, class: "site-header-mobile-link" %>
      <% end %>
    </div>
  </div>
</header>
