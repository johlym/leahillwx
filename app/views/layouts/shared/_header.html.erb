<header class="site-header" data-controller="mobile-menu">
  <nav aria-label="Global" class="nav">
    <div class="logo-container">
      <a href="/" class="logo">
        <%= image_tag "logo.png", alt: "Lea Hill Weather", class: "logo-image" %>
        <span class="logo-text">Lea Hill Weather</span>
      </a>
    </div>
    <div class="mobile-toggle-container">
      <button type="button" class="mobile-toggle" data-mobile-menu-target="button" data-action="click->mobile-menu#toggle" aria-expanded="false">
        <span class="sr-only">Open main menu</span>
        <i class="fa-regular fa-bars icon" aria-hidden="true" data-mobile-menu-target="openIcon"></i>
        <i class="fa-regular fa-x icon hidden" aria-hidden="true" data-mobile-menu-target="closeIcon"></i>
      </button>
    </div>
    <div class="nav-links">
      <%= link_to "Live", root_path, class: "nav-link" %>
      <%= link_to "Reports", reports_path, class: "nav-link" %>
      <%= link_to "Records", records_path, class: "nav-link" %>
      <%= link_to "Almanac", almanac_path, class: "nav-link" %>
      <%= link_to "About", about_path, class: "nav-link" %>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu hidden" data-mobile-menu-target="menu">
    <div class="mobile-menu-inner">
      <%= link_to "Live", root_path, class: "mobile-link" %>
      <%= link_to "Reports", reports_path, class: "mobile-link" %>
      <%= link_to "Records", records_path, class: "mobile-link" %>
      <%= link_to "Almanac", almanac_path, class: "mobile-link" %>
      <%= link_to "About", about_path, class: "mobile-link" %>
    </div>
  </div>
</header>
