<nav class="header-navigation">
  <div class="header-navigation__container">
    <div class="header-navigation__container__inner">
      <div class="mobile-menu-container">
        <!-- Mobile menu button-->
        <button type="button" command="--toggle" commandfor="mobile-menu" class="mobile-menu-button">
          <span class="absolute -inset-0.5"></span>
          <span class="sr-only">Open main menu</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 in-aria-expanded:hidden">
            <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 not-in-aria-expanded:hidden">
            <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
      <div class="navigation-container">
        <div class="site-title-container">
          <span class="site-title">Lea Hill Weather</span>
        </div>
        <div class="navigation-links-container">
          <div class="navigation-links">
            <!-- Current: "bg-gray-900 dark:bg-gray-950/50 text-white", Default: "text-gray-300 hover:bg-white/5 hover:text-white" -->
            <%= link_to "Live", root_path, class: "navigation-link" %>
            <%= link_to "Reports (soon)", root_path, class: "navigation-link" %>
            <%= link_to "Records (soon)", root_path, class: "navigation-link" %>
            <%= link_to "About (soon)", root_path, class: "navigation-link" %>
            <%= link_to "Contact (soon)", root_path, class: "navigation-link" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <el-disclosure id="mobile-menu" hidden class="block sm:hidden">
    <div class="mobile-menu-container">
      <%= link_to "Live", root_path, class: "mobile-menu-link" %>
      <%= link_to "Reports (soon)", root_path, class: "mobile-menu-link" %>
      <%= link_to "Records (soon)", root_path, class: "mobile-menu-link" %>
      <%= link_to "About (soon)", root_path, class: "mobile-menu-link" %>
      <%= link_to "Contact (soon)", root_path, class: "mobile-menu-link" %>
    </div>
  </el-disclosure>
</nav>
