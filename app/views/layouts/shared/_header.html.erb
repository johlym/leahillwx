<header class="site-header" data-controller="mobile-menu">
  <%= turbo_frame_tag "weather_alerts_bar", src: alerts_bar_path %>

  <nav aria-label="Global" class="site-header-nav">
    <div class="site-header-brand-wrap" data-controller="connection-status">
      <a href="/" class="site-header-brand">
        <span class="site-header-logo-tile" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="site-header-logo">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" />
          </svg>
        </span>
        <span class="site-header-brand-text">
          <span class="site-header-title">Lea Hill Weather</span>
          <span class="site-header-live-row hidden" data-connection-status-target="badge">
            <span class="site-header-live-dot" aria-hidden="true"></span>
            <span class="site-header-live-badge">LIVE</span>
          </span>
        </span>
      </a>
    </div>

    <div class="site-header-menu-toggle-wrap">
      <button type="button"
              class="site-header-menu-toggle"
              data-mobile-menu-target="button" data-action="click->mobile-menu#toggle" aria-expanded="false">
        <span class="sr-only">Open main menu</span>
        <i class="fa-regular fa-bars" aria-hidden="true" data-mobile-menu-target="openIcon"></i>
        <i class="fa-regular fa-x hidden" aria-hidden="true" data-mobile-menu-target="closeIcon"></i>
      </button>
    </div>

    <div class="site-header-links">
      <%= link_to "Live",    root_path,    class: nav_link_classes(root_path) %>
      <%= link_to "Radar",   radar_path,   class: nav_link_classes(radar_path) %>
      <%= link_to "Reports", reports_path, class: nav_link_classes(reports_path) %>
      <%= link_to "Records", records_path, class: nav_link_classes(records_path) %>
      <%= link_to "Graphs",  graphs_path,  class: nav_link_classes(graphs_path) %>
      <%= link_to "Trends",  trends_path,  class: nav_link_classes(trends_path) %>
      <%= link_to "Almanac", almanac_path, class: nav_link_classes(almanac_path) %>
      <%= link_to "About",   about_path,   class: nav_link_classes(about_path) %>
    </div>

    <% if @current&.reading_date_time || content_for?(:header_meta) %>
      <div class="site-header-meta">
        <% if content_for?(:header_meta) %>
          <%= yield :header_meta %>
        <% else %>
          <span class="site-header-meta-label">Last Updated</span>
          <span class="site-header-meta-value" data-weather-update-target="timestamp">
            <%= @current.reading_date_time.in_time_zone("America/Los_Angeles").strftime("%b %-d, %Y @ %-I:%M %p") %>
          </span>
        <% end %>
      </div>
    <% end %>
  </nav>

  <div id="mobile-menu"
       class="site-header-mobile-menu hidden"
       data-mobile-menu-target="menu">
    <div class="site-header-mobile-links">
      <% [
           ["Live",    root_path],
           ["Radar",   radar_path],
           ["Reports", reports_path],
           ["Records", records_path],
           ["Graphs",  graphs_path],
           ["Trends",  trends_path],
           ["Almanac", almanac_path],
           ["About",   about_path]
         ].each do |label, path| %>
        <%= link_to label, path, class: "site-header-mobile-link" %>
      <% end %>
    </div>
  </div>
</header>
