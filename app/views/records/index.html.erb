<div class="primary-container report-container">
  <div class="date-navigation">
    <div class="navigation-controls">
      <div class="control-group">
        <label for="year-select" class="sr-only">Year:</label>
        <select id="year-select" 
                name="year"
                onchange="window.location.href = '<%= records_path %>/' + this.value">
          <% @available_years.each do |available_year| %>
            <option value="<%= available_year %>" <%= 'selected' if available_year == @selected_year %>>
              <%= available_year %>
            </option>
          <% end %>
        </select>
      </div>
    </div>
  </div>

  <% if @selected_year_record || @current_year_record || @all_time_record %>
    <%= render Records::RecordsComponent.new(
      selected_year_record: @selected_year_record,
      current_year_record: @current_year_record,
      all_time_record: @all_time_record,
      selected_year: @selected_year,
      current_year: @current_year
    ) %>
  <% else %>
    <p class="no-records-message">
      No records available yet. Records will be calculated nightly starting at 12:02 AM, or you can run the rake task manually.
    </p>
  <% end %>
</div>
